    <!-- JavaScript Application Engine -->
    <script>
        /* Lucide Icons Initialization */
        lucide.createIcons();

        /* Application Global State */
        let state = {
            currency: 'INR', // 'INR' or 'USD'
            exchangeRate: 83.5, // 1 USD = 83.5 INR
            liftType: {
                id: 'passenger',
                name: 'Passenger Elevator',
                basePriceINR: 950000
            },
            floors: 2, // G + 2 (3 Stops)
            capacity: {
                pax: 6,
                kg: 408,
                multiplier: 1.12
            },
            finish: {
                id: 'gold',
                name: 'Mirror Gold Luxury',
                priceINR: 120000,
                cssClass: 'cabin-texture-gold'
            },
            upgrades: {
                ard: { name: 'ARD Emergency Battery', priceINR: 65000, active: true },
                touchless: { name: 'Touchless Buttons', priceINR: 45000, active: false },
                vvvf: { name: 'VVVF Drive Inverter', priceINR: 85000, active: true },
                marble: { name: 'Italian Marble Floor', priceINR: 55000, active: false }
            }
        };

        /* Lift Type Options Data */
        const LIFT_TYPES = {
            passenger: { name: 'Passenger Elevator', baseINR: 950000 },
            villa: { name: 'Luxury Villa / Home Lift', baseINR: 1100000 },
            panoramic: { name: 'Panoramic Glass Lift', baseINR: 1450000 },
            freight: { name: 'Commercial & Goods', baseINR: 1600000 },
            hospital: { name: 'Hospital Bed Elevator', baseINR: 1350000 }
        };

        /* Currency Switcher */
        function setCurrency(curr) {
            state.currency = curr;
            const inrBtn = document.getElementById('curr-inr');
            const usdBtn = document.getElementById('curr-usd');

            if (curr === 'INR') {
                inrBtn.className = "px-2.5 py-1 rounded-md transition-all bg-gold-500 text-darkbg-900 shadow";
                usdBtn.className = "px-2.5 py-1 rounded-md transition-all text-slate-400 hover:text-white";
            } else {
                usdBtn.className = "px-2.5 py-1 rounded-md transition-all bg-gold-500 text-darkbg-900 shadow";
                inrBtn.className = "px-2.5 py-1 rounded-md transition-all text-slate-400 hover:text-white";
            }
            recalculate();
        }

        /* Format Currency Helper */
        function formatMoney(amountINR) {
            if (state.currency === 'USD') {
                const usd = Math.round(amountINR / state.exchangeRate);
                return '$' + usd.toLocaleString('en-US');
            } else {
                return '₹' + amountINR.toLocaleString('en-IN');
            }
        }

        /* Select Lift Type handler */
        function selectLiftType(typeKey) {
            const info = LIFT_TYPES[typeKey];
            state.liftType = { id: typeKey, name: info.name, basePriceINR: info.baseINR };

            // Update UI card highlight
            document.querySelectorAll('.lift-type-card').forEach(btn => {
                btn.className = "lift-type-card p-4 rounded-xl border border-slate-800 bg-darkbg-800 text-left transition-all hover:border-gold-400 group relative";
            });
            const activeBtn = document.getElementById(`type-${typeKey}`);
            if (activeBtn) {
                activeBtn.className = "lift-type-card p-4 rounded-xl border border-gold-500 bg-gold-500/10 text-left transition-all hover:border-gold-400 group relative";
            }

            recalculate();
        }

        /* Floors Range & Buttons handler */
        function updateFloors(val) {
            state.floors = parseInt(val);
            document.getElementById('floor-display-val').innerText = `G + ${state.floors} Floors`;
            document.getElementById('floor-count-sub').innerText = `(${state.floors + 1} Stops Total)`;
            recalculate();
        }

        function setFloorVal(val) {
            document.getElementById('floor-slider').value = val;
            updateFloors(val);
        }

        /* Select Capacity handler */
        function selectCapacity(pax, kg, mult, btnElement) {
            state.capacity = { pax, kg, multiplier: mult };
            document.querySelectorAll('.cap-btn').forEach(b => {
                b.className = "cap-btn p-3 rounded-xl border border-slate-800 bg-darkbg-800 text-center hover:border-gold-500 transition-all";
                const txt = b.querySelector('.block');
                if (txt) txt.className = "block text-sm font-bold text-white";
            });
            btnElement.className = "cap-btn p-3 rounded-xl border border-gold-500 bg-gold-500/10 text-center transition-all";
            btnElement.querySelector('.block').className = "block text-sm font-bold text-gold-400";
            recalculate();
        }

        /* Select Interior Finish handler */
        function selectFinish(id, name, priceINR, btnElement) {
            const textureMap = {
                hairline: 'cabin-texture-hairline',
                gold: 'cabin-texture-gold',
                glass: 'cabin-texture-glass',
                wood: 'cabin-texture-wood',
                rosegold: 'cabin-texture-rosegold'
            };

            state.finish = { id, name, priceINR, cssClass: textureMap[id] };

            document.querySelectorAll('.finish-btn').forEach(b => {
                b.className = "finish-btn p-3.5 rounded-xl border border-slate-800 bg-darkbg-800 flex items-center gap-3 text-left hover:border-gold-500 transition-all";
            });
            btnElement.className = "finish-btn p-3.5 rounded-xl border border-gold-500 bg-gold-500/10 flex items-center gap-3 text-left transition-all";

            // Update Visual Preview Box Texture
            const cabinEl = document.getElementById('visual-cabin');
            cabinEl.className = `w-full max-w-[220px] h-36 rounded-lg ${textureMap[id]} p-3 flex flex-col justify-between shadow-2xl transition-all duration-500 relative`;

            document.getElementById('finish-badge').innerText = name;
            recalculate();
        }

        /* Toggle Upgrades */
        function toggleUpgrade(key, priceINR, checkbox) {
            state.upgrades[key].active = checkbox.checked;
            recalculate();
        }

        /* Core Budget & Price Calculation Engine */
        function recalculate() {
            // Base Equipment
            const baseINR = state.liftType.basePriceINR;

            // Floor Addition (₹75,000 per additional floor over 1)
            const floorCostINR = (state.floors - 1) * 75000;

            // Apply Capacity Multiplier to Equipment Base
            const baseWithCapacity = (baseINR + floorCostINR) * state.capacity.multiplier;

            // Finish Premium
            const finishCostINR = state.finish.priceINR;

            // Upgrades Total
            let upgradesTotalINR = 0;
            Object.values(state.upgrades).forEach(up => {
                if (up.active) upgradesTotalINR += up.priceINR;
            });

            // Installation Estimate (~8% of total equipment)
            const subtotalINR = baseWithCapacity + finishCostINR + upgradesTotalINR;
            const installationINR = Math.round(subtotalINR * 0.08);

            const totalTurnkeyINR = Math.round(subtotalINR + installationINR);

            // Update Summary Breakdown Text in UI
            document.getElementById('summary-type-name').innerText = state.liftType.name;
            document.getElementById('cost-base').innerText = formatMoney(baseINR);

            document.getElementById('summary-floors-count').innerText = `G+${state.floors} (${state.floors + 1} Stops)`;
            document.getElementById('cost-floors').innerText = formatMoney(floorCostINR);

            document.getElementById('summary-capacity').innerText = `${state.capacity.pax} Pax / ${state.capacity.kg}kg`;
            document.getElementById('cost-capacity').innerText = `x${state.capacity.multiplier}`;

            document.getElementById('summary-finish').innerText = state.finish.name;
            document.getElementById('cost-finish').innerText = formatMoney(finishCostINR);

            document.getElementById('cost-upgrades').innerText = formatMoney(upgradesTotalINR);
            document.getElementById('cost-installation').innerText = formatMoney(installationINR);

            // Final Total & EMI
            document.getElementById('total-price-display').innerText = formatMoney(totalTurnkeyINR);

            const emiINR = Math.round((totalTurnkeyINR * 0.018)); // Approx 1.8% monthly EMI factor
            document.getElementById('emi-display').innerText = formatMoney(emiINR) + '/mo';

            // Update Upgrade Price Tags in UI according to current currency
            document.querySelectorAll('.upgrade-price').forEach(el => {
                const inrVal = parseInt(el.getAttribute('data-inr'));
                el.innerText = formatMoney(inrVal);
            });
        }

        /* Lift Motion Visual Simulator */
        function moveLiftTo(position) {
            const cabin = document.getElementById('visual-cabin');
            const floorDisp = document.getElementById('sim-floor-display');

            if (position === 'Top') {
                cabin.style.transform = 'translateY(-30px)';
                floorDisp.innerText = `POS: FLOOR ${state.floors} (TOP)`;
            } else if (position === 'Mid') {
                cabin.style.transform = 'translateY(0px)';
                floorDisp.innerText = `POS: FLOOR ${Math.round(state.floors / 2)} (MID)`;
            } else { // Ground
                cabin.style.transform = 'translateY(30px)';
                floorDisp.innerText = `POS: GROUND FLOOR (0)`;
            }
        }

        /* Modals & Receipts */
        function openQuoteModal() {
            document.getElementById('quote-modal').classList.remove('hidden');
            document.getElementById('modal-form-screen').classList.remove('hidden');
            document.getElementById('modal-receipt-screen').classList.add('hidden');
        }

        function closeQuoteModal() {
            document.getElementById('quote-modal').classList.add('hidden');
        }

        function openSiteModal() {
            document.getElementById('site-modal').classList.remove('hidden');
        }

        function closeSiteModal() {
            document.getElementById('site-modal').classList.add('hidden');
        }

        function generateQuoteReceipt(e) {
            e.preventDefault();
            const name = document.getElementById('cust-name').value;
            const phone = document.getElementById('cust-phone').value;
            const email = document.getElementById('cust-email').value;
            const city = document.getElementById('cust-city').value;

            // Populate Receipt Fields
            document.getElementById('rec-id').innerText = `LEO-${new Date().getFullYear()}-${Math.floor(1000 + Math.random() * 9000)}`;
            document.getElementById('rec-date').innerText = `Date: ${new Date().toLocaleDateString()}`;
            document.getElementById('rec-client').innerText = `${name} (${phone})`;
            document.getElementById('rec-location').innerText = `${city} • ${email}`;

            document.getElementById('rec-type').innerText = state.liftType.name;
            document.getElementById('rec-floors').innerText = `G + ${state.floors} (${state.floors + 1} Stops)`;
            document.getElementById('rec-capacity').innerText = `${state.capacity.pax} Pax (${state.capacity.kg} kg)`;
            document.getElementById('rec-style').innerText = state.finish.name;

            // Calculate total again for receipt display
            const baseINR = state.liftType.basePriceINR;
            const floorCostINR = (state.floors - 1) * 75000;
            const baseWithCapacity = (baseINR + floorCostINR) * state.capacity.multiplier;
            const finishCostINR = state.finish.priceINR;
            let upgradesTotalINR = 0;
            Object.values(state.upgrades).forEach(up => { if (up.active) upgradesTotalINR += up.priceINR; });
            const subtotal = baseWithCapacity + finishCostINR + upgradesTotalINR;
            const total = Math.round(subtotal * 1.08);

            document.getElementById('rec-total').innerText = formatMoney(total);

            // Switch to receipt screen
            document.getElementById('modal-form-screen').classList.add('hidden');
            document.getElementById('modal-receipt-screen').classList.remove('hidden');
        }

        function submitSiteSurvey(e) {
            e.preventDefault();
            closeSiteModal();
            // User feedback
            const toast = document.createElement('div');
            toast.className = 'fixed bottom-6 right-6 z-50 glass-card bg-emerald-500/20 border border-emerald-500 text-white px-5 py-3 rounded-2xl flex items-center gap-3 shadow-2xl';
            toast.innerHTML = `<i data-lucide="check-circle" class="w-5 h-5 text-emerald-400"></i><span class="text-xs font-bold">Site Survey Requested! Our team will contact you shortly.</span>`;
            document.body.appendChild(toast);
            lucide.createIcons();
            setTimeout(() => toast.remove(), 4000);
        }

        /* FAQ Accordion Toggle */
        function toggleFaq(headerEl) {
            const p = headerEl.nextElementSibling;
            p.classList.toggle('hidden');
            const icon = headerEl.querySelector('i');
            if (p.classList.contains('hidden')) {
                icon.style.transform = 'rotate(0deg)';
            } else {
                icon.style.transform = 'rotate(180deg)';
            }
        }

        /* Mobile Menu Toggle */
        function toggleMobileMenu() {
            const menu = document.getElementById('mobile-menu');
            menu.classList.toggle('hidden');
        }

        /* Initial Calculation Run on Page Load */
        window.onload = function() {
            recalculate();
        };
    </script>
</body>
</html>
