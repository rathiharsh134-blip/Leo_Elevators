                    <h4 class="text-xs font-bold uppercase tracking-wider text-slate-200 mb-4">Elevators</h4>
                    <ul class="space-y-2 text-xs text-slate-400" id="footerLifts"></ul>
                </div>
                <div>
                    <h4 class="text-xs font-bold uppercase tracking-wider text-slate-200 mb-4">Interactive Tools</h4>
                    <ul class="space-y-2 text-xs text-slate-400">
                        <li><a href="#simulator" class="hover:text-cyan-400 transition-colors">Live Shaft Simulator</a></li>
                        <li><a href="#customizer" class="hover:text-cyan-400 transition-colors">Cabin Customizer</a></li>
                        <li><a href="#customizer" class="hover:text-cyan-400 transition-colors">Price Estimator</a></li>
                        <li><a href="#tech" class="hover:text-cyan-400 transition-colors">AI Diagnostics</a></li>
                    </ul>
                </div>
                <div>
                    <h4 class="text-xs font-bold uppercase tracking-wider text-slate-200 mb-4">Compliance</h4>
                    <ul class="space-y-2 text-xs text-slate-400">
                        <li>ISO 9001:2015 Quality</li><li>EN81 Safety Directives</li><li>CE Certified Machinery</li><li>Class A+++ Eco Drive</li>
                    </ul>
                </div>
            </div>
            <div class="border-t border-slate-800 pt-8 flex flex-col sm:flex-row items-center justify-between text-xs text-slate-500 gap-4">
                <div>&copy; <span id="year">2026</span> LEO Elevators Inc. All rights reserved.</div>
                <div class="flex space-x-6">
                    <a href="#" class="hover:text-slate-400">Privacy Policy</a>
                    <a href="#" class="hover:text-slate-400">Terms of Service</a>
                    <a href="#" class="hover:text-slate-400">Safety Directives</a>
                </div>
            </div>
        </div>
    </footer>

    <!-- Selection toast -->
    <div id="toast" class="fixed bottom-6 left-1/2 -translate-x-1/2 z-[60] glass-panel px-5 py-3 rounded-2xl text-sm font-semibold flex items-center gap-3 opacity-0 pointer-events-none translate-y-4" role="status" aria-live="polite"></div>

    <!-- Success modal -->
    <div id="successModal" class="fixed inset-0 z-[70] flex items-center justify-center p-4 bg-slate-950/80 backdrop-blur-md hidden" role="dialog" aria-modal="true" aria-labelledby="modalTitle">
        <div class="glass-panel max-w-md w-full p-8 rounded-3xl border border-emerald-500/40 text-center space-y-4 pop">
            <div class="w-16 h-16 rounded-full bg-emerald-500/20 text-emerald-400 text-3xl flex items-center justify-center mx-auto border border-emerald-400"><i class="fa-solid fa-check"></i></div>
            <h3 id="modalTitle" class="font-display text-2xl font-bold">Quote Request Received!</h3>
            <p class="text-slate-300 text-xs leading-relaxed">Thank you for contacting LEO Elevators. An engineering consultant has been assigned to your project and will email your formal specification sheet shortly.</p>
            <button id="modalClose" class="btn-gradient w-full py-3 rounded-xl bg-gradient-to-r from-indigo-600 to-emerald-500 text-white font-bold text-xs uppercase tracking-wider">Close Window</button>
        </div>
    </div>

<script>
(() => {
    'use strict';

    /* =====================================================
       DATA: one source of truth for every lift type
       ===================================================== */
    const LIFTS = [
        { key: 'villa', name: 'Home / Villa Lift', tag: 'Residential', icon: 'fa-house-chimney', color: '#6366f1',
          desc: 'Compact gearless home elevator with minimal pit. Ideal for 2 to 4-storey private residences.',
          speed: '1.0 m/s', cap: '4-6 persons (450 kg)', drive: 'Eco Silent Belt', base: 22000, perFloor: 1000, maxFloors: 6, defaultFloors: 4,
          img: 'https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=700&q=80' },
        { key: 'passenger', name: 'Passenger Lift', tag: 'Residential / Commercial', icon: 'fa-people-roof', color: '#06b6d4',
          desc: 'The everyday workhorse for apartments, offices and mid-rise buildings with smooth, quiet rides.',
          speed: '1.75 m/s', cap: '8-13 persons (1000 kg)', drive: 'Gearless Traction', base: 32000, perFloor: 1300, maxFloors: 20, defaultFloors: 8,
          img: 'https://images.unsplash.com/photo-1545324418-cc1a3fa10c00?auto=format&fit=crop&w=700&q=80' },
        { key: 'highrise', name: 'High-Speed Skyscraper', tag: 'Commercial', icon: 'fa-building', color: '#8b5cf6',
          desc: 'Ultra high-speed AI-dispatched elevators for corporate towers and luxury hotels.',
          speed: 'Up to 6.0 m/s', cap: '16-24 persons (1600 kg)', drive: 'Synapse AI Traction', base: 42000, perFloor: 1800, maxFloors: 30, defaultFloors: 15,
          img: 'https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?auto=format&fit=crop&w=700&q=80' },
        { key: 'panoramic', name: 'Glass Panoramic Lift', tag: 'Architectural', icon: 'fa-eye', color: '#10b981',
          desc: '360-degree curved glass observation cabin for malls, atriums, hotels and villas.',
          speed: '2.5 m/s', cap: '8-12 persons (1000 kg)', drive: 'Curved Safety Glass', base: 38000, perFloor: 1600, maxFloors: 25, defaultFloors: 6,
          img: 'https://images.unsplash.com/photo-1513694203232-719a280e022f?auto=format&fit=crop&w=700&q=80' },
        { key: 'freight', name: 'Freight / Goods Lift', tag: 'Industrial', icon: 'fa-truck-ramp-box', color: '#f59e0b',
          desc: 'Heavy-duty goods elevator engineered for warehouses, factories and logistics hubs.',
          speed: '1.5 m/s', cap: 'Up to 5,000 kg', drive: 'Reinforced Steel Floor', base: 55000, perFloor: 2200, maxFloors: 12, defaultFloors: 3,
          img: 'https://images.unsplash.com/photo-1581091226825-a6a2a5aee158?auto=format&fit=crop&w=700&q=80' },
        { key: 'hospital', name: 'Hospital / Bed Lift', tag: 'Healthcare', icon: 'fa-bed-pulse', color: '#ef4444',
          desc: 'Extra-deep cabin for beds and stretchers with priority dispatch and anti-bacterial surfaces.',
          speed: '1.6 m/s', cap: 'Bed + 8 persons (1600-2500 kg)', drive: 'Priority Medical Dispatch', base: 36000, perFloor: 1500, maxFloors: 15, defaultFloors: 5,
          img: 'https://images.unsplash.com/photo-1519494026892-80bbd2d6fd0d?auto=format&fit=crop&w=700&q=80' },
        { key: 'car', name: 'Car / Vehicle Lift', tag: 'Industrial', icon: 'fa-car', color: '#0ea5e9',
          desc: 'Heavy platform lift that moves vehicles between parking levels, showrooms and basements.',
          speed: '0.5 m/s', cap: 'Up to 3,000 kg', drive: 'Hydraulic Platform', base: 48000, perFloor: 2500, maxFloors: 8, defaultFloors: 3,
          img: 'https://images.unsplash.com/photo-1506521781263-d8422e82f27a?auto=format&fit=crop&w=700&q=80' },
        { key: 'accessible', name: 'Wheelchair Platform Lift', tag: 'Accessibility', icon: 'fa-wheelchair', color: '#14b8a6',
          desc: 'Barrier-free platform lift for homes, schools and public buildings with short-rise access.',
          speed: '0.15 m/s', cap: '1 wheelchair (300 kg)', drive: 'Screw / Hydraulic', base: 12000, perFloor: 800, maxFloors: 4, defaultFloors: 2,
          img: 'https://images.unsplash.com/photo-1573497019940-1c28c88b4f3e?auto=format&fit=crop&w=700&q=80' },
        { key: 'service', name: 'Dumbwaiter / Service Lift', tag: 'Hospitality', icon: 'fa-utensils', color: '#ec4899',
          desc: 'Compact service lift for kitchens, restaurants, libraries and hotels to move small loads.',
          speed: '0.4 m/s', cap: 'Up to 100 kg', drive: 'Compact Traction', base: 8000, perFloor: 500, maxFloors: 6, defaultFloors: 2,
          img: 'https://images.unsplash.com/photo-1414235077428-338989a2e8c0?auto=format&fit=crop&w=700&q=80' }
    ];
    const FINISHES = [
        { key: 'gold',   label: 'Gold Mirror & LED',   price: 4500, badge: 'GOLD MIRROR STYLE',       icon: 'fa-gem',         iconCls: 'bg-amber-500/20 border-amber-400 text-amber-400', priceCls: 'text-amber-400' },
        { key: 'steel',  label: 'Brushed Stainless',   price: 0,    badge: 'BRUSHED STAINLESS STEEL', icon: 'fa-layer-group', iconCls: 'bg-slate-700 border-slate-500 text-slate-300',    priceCls: 'text-slate-400' },
        { key: 'glass',  label: 'Curved Glass Wall',   price: 6500, badge: 'CURVED GLASS WALL',       icon: 'fa-glasses',     iconCls: 'bg-sky-500/20 border-sky-400 text-sky-400',       priceCls: 'text-cyan-400' },
        { key: 'walnut', label: 'Walnut & Matte Black',price: 3200, badge: 'WALNUT & MATTE BLACK',    icon: 'fa-tree',        iconCls: 'bg-amber-900/30 border-amber-800 text-amber-600', priceCls: 'text-amber-500' }
    ];

    const $ = (s, r = document) => r.querySelector(s);
    const $$ = (s, r = document) => [...r.querySelectorAll(s)];
    const money = n => '$' + n.toLocaleString('en-US');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    $('#year').textContent = new Date().getFullYear();

    /* =====================================================
       Theme + mobile menu
       ===================================================== */
    const root = document.documentElement;
    function setTheme(mode) {
        root.classList.toggle('dark', mode === 'dark');
        root.classList.toggle('light', mode === 'light');
        try { localStorage.setItem('leo-theme', mode); } catch (e) {}
    }
    try { const saved = localStorage.getItem('leo-theme'); if (saved) setTheme(saved); } catch (e) {}
    const toggleTheme = () => setTheme(root.classList.contains('dark') ? 'light' : 'dark');
    $('#themeToggle').addEventListener('click', toggleTheme);
    $('#mobileThemeToggle').addEventListener('click', toggleTheme);

    const menuBtn = $('#mobileMenuBtn'), menu = $('#mobileMenu');
    menuBtn.addEventListener('click', () => {
        const open = menu.classList.toggle('hidden') === false;
        menuBtn.setAttribute('aria-expanded', open);
    });
    $$('a', menu).forEach(a => a.addEventListener('click', () => { menu.classList.add('hidden'); menuBtn.setAttribute('aria-expanded', false); }));

    /* =====================================================
       Toast
       ===================================================== */
    let toastTimer;
    function toast(html) {
        const t = $('#toast');
        t.innerHTML = html;
        t.classList.remove('opacity-0', 'translate-y-4');
        clearTimeout(toastTimer);
        toastTimer = setTimeout(() => t.classList.add('opacity-0', 'translate-y-4'), 2600);
    }

    /* =====================================================
       Scroll reveal + count-up
       ===================================================== */
    const io = new IntersectionObserver(entries => {
        entries.forEach(e => {
            if (!e.isIntersecting) return;
            e.target.classList.add('in-view');
            const c = e.target.querySelector('[data-count]');
            if (c) countUp(c);
            io.unobserve(e.target);
        });
    }, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });
    $$('.reveal').forEach(el => io.observe(el));

    function countUp(el) {
        if (reduceMotion) return;
        const target = parseFloat(el.dataset.count), dec = parseInt(el.dataset.decimals || 0), suf = el.dataset.suffix || '';
        const start = performance.now(), dur = 1400;
        (function tick(now) {
            const p = Math.min((now - start) / dur, 1), eased = 1 - Math.pow(1 - p, 3);
            el.textContent = (target * eased).toLocaleString('en-US', { minimumFractionDigits: dec, maximumFractionDigits: dec }) + suf;
            if (p < 1) requestAnimationFrame(tick);
        })(start);
    }

    /* =====================================================
       LIFT SHOWCASE CAROUSEL
       ===================================================== */
    const scroller = $('#liftScroller');
    let selectedKey = 'villa';

    scroller.innerHTML = LIFTS.map((l, i) => `
        <div class="lift-card" role="option" tabindex="0" data-key="${l.key}" aria-selected="false" aria-label="${l.name}. Click to select." style="transition-delay:${i * 60}ms">
            <div class="photo">
                <div class="fallback" style="color:${l.color}"><i class="fa-solid ${l.icon}"></i></div>
                <img src="${l.img}" alt="${l.name}" loading="lazy" draggable="false">
                <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-transparent to-transparent"></div>
                <span class="photo-caption absolute top-3 left-3 px-3 py-1 rounded-full text-white text-[10px] font-bold uppercase tracking-wider" style="background:${l.color}">${l.tag}</span>
                <span class="check"><i class="fa-solid fa-check"></i></span>
            </div>
            <div class="p-5 space-y-3">
                <h3 class="meta-text font-display text-lg font-bold flex items-center gap-2"><i class="fa-solid ${l.icon}" style="color:${l.color}"></i>${l.name}</h3>
                <p class="text-slate-400 text-xs leading-relaxed min-h-[48px]">${l.desc}</p>
                <div class="space-y-1.5 border-t border-slate-800 pt-3 text-[11px] font-mono text-slate-300">
                    <div class="flex justify-between"><span class="text-slate-500">Speed</span><span>${l.speed}</span></div>
                    <div class="flex justify-between gap-3"><span class="text-slate-500">Capacity</span><span class="text-right">${l.cap}</span></div>
                    <div class="flex justify-between gap-3"><span class="text-slate-500">From</span><span class="text-emerald-400">${money(l.base)}</span></div>
                </div>
                <div class="btn-gradient w-full text-center py-2.5 rounded-xl bg-gradient-to-r from-indigo-600 to-cyan-600 text-xs font-bold text-white">Select This Lift <i class="fa-solid fa-arrow-right ml-1"></i></div>
            </div>
        </div>`).join('');

    // Image fallback (keeps the card attractive if a photo fails to load)
    $$('.lift-card img').forEach(img => img.addEventListener('error', () => {
        img.style.display = 'none';
        img.parentElement.querySelector('.fallback').style.display = 'flex';
    }));

    const cards = $$('.lift-card', scroller);

    // Responsive side padding so first/last cards can center
    function padScroller() {
        const w = cards[0].offsetWidth || 300;
        scroller.style.paddingLeft = scroller.style.paddingRight = `calc(50% - ${w / 2}px)`;
    }

    // Scroll-linked animation: scale / tilt / fade / parallax based on distance from center
    let ticking = false;
    function animateCards() {
        const rect = scroller.getBoundingClientRect();
        const center = rect.left + rect.width / 2;
        cards.forEach(card => {
            const r = card.getBoundingClientRect();
            const d = (r.left + r.width / 2 - center) / (rect.width / 2);   // -1..1 roughly
            const a = Math.min(Math.abs(d), 1.2);
            if (!reduceMotion) {
                card.style.transform = `translateY(${a * 24}px) scale(${1 - a * 0.14}) rotateY(${d * -14}deg)`;
                card.style.opacity = String(1 - Math.min(a, 1) * 0.55);
                const img = $('img', card);
                if (img) img.style.transform = `translateX(${d * -22}px)`;
            }
            card.style.zIndex = String(Math.round(10 - a * 5));
        });
        const max = scroller.scrollWidth - scroller.clientWidth;
        $('#liftProgress').style.width = (max > 0 ? (scroller.scrollLeft / max) * 100 : 0) + '%';
        ticking = false;
    }
    scroller.addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(animateCards); } }, { passive: true });
    window.addEventListener('resize', () => { padScroller(); animateCards(); });
    padScroller();

    // Entrance animation when the carousel scrolls into view
    new IntersectionObserver((entries, obs) => {
        if (entries[0].isIntersecting) {
            scroller.classList.add('ready');
            setTimeout(animateCards, 50);
            obs.disconnect();
        }
    }, { threshold: 0.2 }).observe(scroller);

    // Arrows
    const step = () => (cards[0].offsetWidth || 300) + 24;
    $('#liftPrev').addEventListener('click', () => scroller.scrollBy({ left: -step(), behavior: 'smooth' }));
    $('#liftNext').addEventListener('click', () => scroller.scrollBy({ left: step(), behavior: 'smooth' }));

    // Keyboard
    scroller.addEventListener('keydown', e => {
        const idx = cards.indexOf(document.activeElement);
        if (e.key === 'ArrowRight' && idx < cards.length - 1) { cards[idx + 1].focus({ preventScroll: true }); cards[idx + 1].scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' }); e.preventDefault(); }
        if (e.key === 'ArrowLeft' && idx > 0) { cards[idx - 1].focus({ preventScroll: true }); cards[idx - 1].scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' }); e.preventDefault(); }
        if ((e.key === 'Enter' || e.key === ' ') && idx >= 0) { e.preventDefault(); chooseLift(cards[idx].dataset.key, true); }
    });

    // Mouse drag-to-scroll (touch uses native scrolling) with click suppression
    let drag = { active: false, startX: 0, startLeft: 0, moved: false };
    scroller.addEventListener('pointerdown', e => {
        if (e.pointerType !== 'mouse') return;
        drag = { active: true, startX: e.clientX, startLeft: scroller.scrollLeft, moved: false };
    });
    window.addEventListener('pointermove', e => {
        if (!drag.active) return;
        const dx = e.clientX - drag.startX;
        if (Math.abs(dx) > 5) { drag.moved = true; scroller.classList.add('dragging'); }
        if (drag.moved) scroller.scrollLeft = drag.startLeft - dx;
    });
    window.addEventListener('pointerup', () => {
        if (!drag.active) return;
        drag.active = false;
        scroller.classList.remove('dragging');
        setTimeout(() => (drag.moved = false), 0);
    });

    // Click a lift -> select it
    scroller.addEventListener('click', e => {
        const card = e.target.closest('.lift-card');
        if (!card || drag.moved) return;
        chooseLift(card.dataset.key, true);
    });

    function markSelected(key) {
        cards.forEach(c => {
            const on = c.dataset.key === key;
            c.classList.toggle('selected', on);
            c.setAttribute('aria-selected', on);
        });
    }

    /* =====================================================
       CUSTOMIZER
       ===================================================== */
    const cfg = { type: LIFTS[0], floors: 4, finish: FINISHES[0], door: 0 };

    $('#typeButtons').innerHTML = LIFTS.map(l => `
        <button type="button" data-type="${l.key}" class="type-btn p-3 rounded-xl border text-left transition-all">
            <div class="font-bold text-[13px] leading-tight"><i class="fa-solid ${l.icon} mr-1.5" style="color:${l.color}"></i>${l.name.replace(' Lift', '')}</div>
            <div class="text-[10px] text-slate-400 mt-1">${l.tag}</div>
        </button>`).join('');

    $('#finishButtons').innerHTML = FINISHES.map(f => `
        <button type="button" data-finish="${f.key}" class="finish-btn p-3 rounded-xl border text-left flex items-center gap-3 transition-all">
            <span class="w-8 h-8 rounded-lg border flex items-center justify-center shrink-0 ${f.iconCls}"><i class="fa-solid ${f.icon}"></i></span>
            <div><div class="font-semibold text-xs">${f.label}</div>
            <div class="text-[10px] ${f.priceCls}">${f.price ? '+' + money(f.price) : 'Included'}</div></div>
        </button>`).join('');

    $('#formBuildingType').innerHTML = LIFTS.map(l => `<option value="${l.key}">${l.name}</option>`).join('');
    $('#footerLifts').innerHTML = LIFTS.slice(0, 6).map(l => `<li><a href="#lifts" data-key="${l.key}" class="footer-lift hover:text-cyan-400 transition-colors">${l.name}</a></li>`).join('');

    function paintToggle(btns, activeFn) {
        btns.forEach(b => {
            const on = activeFn(b);
            b.classList.toggle('bg-slate-800', on);
            b.classList.toggle('border-cyan-500', on);
            b.classList.toggle('bg-slate-900', !on);
            b.classList.toggle('border-slate-800', !on);
        });
    }

    function setType(key, resetFloors = true) {
        cfg.type = LIFTS.find(l => l.key === key) || LIFTS[0];
        const slider = $('#floorSlider');
        slider.max = cfg.type.maxFloors;
        if (resetFloors) slider.value = cfg.type.defaultFloors;
        if (+slider.value > cfg.type.maxFloors) slider.value = cfg.type.maxFloors;
        $('#sliderMax').textContent = cfg.type.maxFloors;
        $('#sliderMid').textContent = Math.round((2 + cfg.type.maxFloors) / 2);
        $('#cabinLabel').textContent = 'LEO ' + cfg.type.name.toUpperCase();
        $('#formBuildingType').value = cfg.type.key;
        paintToggle($$('.type-btn'), b => b.dataset.type === cfg.type.key);
        updateEstimate();
    }

    function setFinish(key) {
        cfg.finish = FINISHES.find(f => f.key === key) || FINISHES[0];
        $('#cabinPreviewBox').className = `w-full h-64 rounded-2xl border-4 transition-all duration-500 relative flex flex-col justify-between p-4 overflow-hidden style-${cfg.finish.key}`;
        $('#finishBadge').textContent = cfg.finish.badge;
        paintToggle($$('.finish-btn'), b => b.dataset.finish === cfg.finish.key);
        updateEstimate();
    }

    function updateEstimate() {
        cfg.floors = +$('#floorSlider').value;
        cfg.door = +$('#doorSelect').value;
        $('#floorSliderVal').textContent = `${cfg.floors} Stops`;
        const floorCost = (cfg.floors - 2) * cfg.type.perFloor;
        const total = cfg.type.base + floorCost + cfg.finish.price + cfg.door;
        $('#totalPrice').textContent = money(total);
        $('#itemTypeLabel').textContent = cfg.type.name.replace(' Lift', '') + ' Equipment:';
        $('#itemBase').textContent = money(cfg.type.base);
        $('#itemFloors').textContent = money(floorCost);
        $('#itemFinish').textContent = money(cfg.finish.price);
        $('#itemDoors').textContent = money(cfg.door);
    }

    $('#typeButtons').addEventListener('click', e => { const b = e.target.closest('.type-btn'); if (b) { setType(b.dataset.type); markSelected(b.dataset.type); selectedKey = b.dataset.type; } });
    $('#finishButtons').addEventListener('click', e => { const b = e.target.closest('.finish-btn'); if (b) setFinish(b.dataset.finish); });
    $('#floorSlider').addEventListener('input', updateEstimate);
    $('#doorSelect').addEventListener('change', updateEstimate);

    // Called when a lift is chosen from the showcase / footer
    function chooseLift(key, scrollToCustomizer) {
        selectedKey = key;
        markSelected(key);
        setType(key);
        const l = cfg.type;
        toast(`<i class="fa-solid ${l.icon}" style="color:${l.color}"></i> ${l.name} selected <i class="fa-solid fa-circle-check text-emerald-400"></i>`);
        if (scrollToCustomizer) {
            setTimeout(() => $('#customizer').scrollIntoView({ behavior: reduceMotion ? 'auto' : 'smooth', block: 'start' }), 450);
        }
    }
    $$('.footer-lift').forEach(a => a.addEventListener('click', e => {
        const card = cards.find(c => c.dataset.key === a.dataset.key);
        setType(a.dataset.key); markSelected(a.dataset.key);
        if (card) setTimeout(() => card.scrollIntoView({ behavior: 'smooth', inline: 'center', block: 'nearest' }), 400);
    }));

    // Spec sheet download
    $('#btnSpec').addEventListener('click', () => {
        const l = cfg.type;
        const door = $('#doorSelect').selectedOptions[0].textContent;
        const text = [
            'LEO ELEVATORS - PROJECT SPECIFICATION SHEET',
            '===========================================',
            `Lift type      : ${l.name}`,
            `Speed          : ${l.speed}`,
            `Capacity       : ${l.cap}`,
            `Drive          : ${l.drive}`,
            `Floors / stops : ${cfg.floors}`,
            `Interior       : ${cfg.finish.label}`,
            `Door system    : ${door}`,
            `Estimated total: ${$('#totalPrice').textContent} (budget estimate)`,
            'Standards      : EN81, ISO 9001, CE',
            `Generated on   : ${new Date().toLocaleDateString()}`
        ].join('\n');
        const url = URL.createObjectURL(new Blob([text], { type: 'text/plain' }));
        const a = document.createElement('a');
        a.href = url; a.download = `LEO_Elevators_Spec_${l.key}.txt`;
        document.body.appendChild(a); a.click(); a.remove();
        setTimeout(() => URL.revokeObjectURL(url), 1000);
    });

    $('#btnLock').addEventListener('click', () => {
        $('#formMessage').value = `Hello, I configured a ${cfg.type.name} with ${cfg.floors} stops, ${cfg.finish.label} interior and "${$('#doorSelect').selectedOptions[0].textContent}". Estimated total: ${$('#totalPrice').textContent}. Please send full technical drawings.`;
    });

    /* =====================================================
       ELEVATOR SIMULATOR
       ===================================================== */
    const FLOOR_NAMES = ['Grand Lobby (G)', 'Innovation Lounge', 'Tech Hub', 'Corporate Suites', 'Penthouse Executive', 'Sky Deck'];
    const cab = $('#elevatorCab'), track = $('#shaftTrack'), doors = $('#doorContainer');
    const arrow = $('#directionArrow'), floorDisp = $('#floorDisplay'), statusMsg = $('#statusMessage'), speedOut = $('#liftSpeedReadout');
    let currentFloor = 0, isMoving = false, timers = [], intervalId = null, audioOn = true;

    $('#copButtons').innerHTML = [5, 4, 3, 2, 1, 0].map(f => {
        const sub = ['Lobby', 'Lounge', 'Tech Hub', 'Corporate', 'Penthouse', 'Sky Deck'][f];
        return `<button type="button" data-floor="${f}" class="cop-btn h-14 rounded-xl bg-slate-800 hover:bg-slate-700 border ${f === 0 ? 'border-cyan-500 text-cyan-400' : 'border-slate-700 text-slate-200'} font-bold text-lg font-mono flex flex-col items-center justify-center transition-all focus:ring-2 focus:ring-cyan-500 focus:outline-none">${f === 0 ? 'G' : f}<span class="text-[9px] font-sans font-normal text-slate-400">${sub}</span></button>`;
    }).join('');

    const maxBottom = () => Math.max(track.clientHeight - cab.offsetHeight, 0);
    const bottomFor = f => (f / 5) * maxBottom();
    const label = f => (f === 0 ? 'G' : String(f));
    function placeCab(f) { cab.style.transitionDuration = '0s'; cab.style.bottom = bottomFor(f) + 'px'; }
    placeCab(0);
    window.addEventListener('resize', () => { if (!isMoving) placeCab(currentFloor); });

    function clearTimers() { timers.forEach(clearTimeout); timers = []; clearInterval(intervalId); }
    function highlightCop(f) {
        $$('.cop-btn').forEach(b => {
            const on = +b.dataset.floor === f;
            b.classList.toggle('border-cyan-500', on); b.classList.toggle('text-cyan-400', on);
            b.classList.toggle('border-slate-700', !on); b.classList.toggle('text-slate-200', !on);
        });
    }

    function chime() {
        if (!audioOn) return;
        try {
            const AC = window.AudioContext || window.webkitAudioContext; if (!AC) return;
            const ctx = new AC();
            [[659.25, 0, .6], [987.77, .2, .8]].forEach(([freq, delay, dur]) => {
                const t = ctx.currentTime + delay, osc = ctx.createOscillator(), g = ctx.createGain();
                osc.type = 'sine'; osc.frequency.setValueAtTime(freq, t);
                g.gain.setValueAtTime(0.15, t); g.gain.exponentialRampToValueAtTime(0.0001, t + dur);
                osc.connect(g); g.connect(ctx.destination); osc.start(t); osc.stop(t + dur);
            });
            setTimeout(() => ctx.close(), 1500);
        } catch (e) { /* audio blocked */ }
    }

    function goToFloor(target) {
        if (isMoving || target === currentFloor) return;
        isMoving = true;
        statusMsg.className = 'text-xs font-mono text-emerald-400 pt-1';
        doors.classList.remove('doors-open');
        highlightCop(target);

        timers.push(setTimeout(() => {
            const up = target > currentFloor, dist = Math.abs(target - currentFloor);
            const dur = Math.max(1.2, dist * 0.8);
            arrow.textContent = up ? '▲' : '▼';
            arrow.className = (up ? 'text-emerald-400' : 'text-cyan-400') + ' font-bold text-3xl animate-bounce';
            statusMsg.textContent = `TRAVELING TO FLOOR ${label(target)}...`;
            speedOut.textContent = '2.5 m/s';
            cab.style.transitionDuration = dur + 's';
            cab.style.bottom = bottomFor(target) + 'px';

            let step = currentFloor;
            intervalId = setInterval(() => {
                step += up ? 1 : -1;
                floorDisp.textContent = label(step);
                if (step === target) clearInterval(intervalId);
            }, (dur * 1000) / dist);

            timers.push(setTimeout(() => {
                currentFloor = target; isMoving = false;
                floorDisp.textContent = label(target);
                speedOut.textContent = '0.0 m/s';
                arrow.className = 'text-slate-600 font-bold text-3xl';
                statusMsg.textContent = `ARRIVED AT ${FLOOR_NAMES[target].toUpperCase()}`;
                chime();
                timers.push(setTimeout(() => doors.classList.add('doors-open'), 300));
            }, dur * 1000));
        }, 450));
    }

    function emergencyStop() {
        if (!isMoving) { statusMsg.textContent = 'EMERGENCY BRAKE ENGAGED'; statusMsg.className = 'text-xs font-mono text-rose-500 font-bold pt-1 animate-pulse'; return; }
        clearTimers();
        // Freeze the cab at its current pixel position
        const cur = parseFloat(getComputedStyle(cab).bottom) || 0;
        cab.style.transitionDuration = '0s';
        cab.style.bottom = cur + 'px';
        const mb = maxBottom();
        currentFloor = Math.min(5, Math.max(0, Math.round((mb ? cur / mb : 0) * 5)));
        isMoving = false;
        speedOut.textContent = '0.0 m/s';
        arrow.className = 'text-rose-500 font-bold text-3xl';
        floorDisp.textContent = label(currentFloor);
        highlightCop(currentFloor);
        statusMsg.textContent = 'EMERGENCY BRAKE ENGAGED - SELECT A FLOOR TO RESUME';
        statusMsg.className = 'text-xs font-mono text-rose-500 font-bold pt-1 animate-pulse';
    }

    $('#copButtons').addEventListener('click', e => {
        const b = e.target.closest('.cop-btn'); if (!b) return;
        const f = +b.dataset.floor;
        // After an emergency stop the cab may sit between floors; snap to the nearest floor first
        if (!isMoving && Math.abs(parseFloat(getComputedStyle(cab).bottom) - bottomFor(currentFloor)) > 1) placeCab(currentFloor);
        goToFloor(f);
    });
    $('#btnOpen').addEventListener('click', () => { if (!isMoving) doors.classList.add('doors-open'); });
    $('#btnClose').addEventListener('click', () => doors.classList.remove('doors-open'));
    $('#btnStop').addEventListener('click', emergencyStop);
    $('#soundStatus').addEventListener('click', () => {
        audioOn = !audioOn;
        const s = $('#soundStatus');
        s.innerHTML = audioOn ? '<i class="fa-solid fa-volume-high"></i> CHIME ON' : '<i class="fa-solid fa-volume-xmark"></i> CHIME OFF';
        s.className = audioOn ? 'text-cyan-400' : 'text-slate-500';
    });

    /* =====================================================
       Contact form + modal
       ===================================================== */
    const modal = $('#successModal');
    const closeModal = () => modal.classList.add('hidden');
    $('#quoteForm').addEventListener('submit', e => {
        e.preventDefault();
        modal.classList.remove('hidden');
        $('#modalClose').focus();
        e.target.reset();
        $('#formBuildingType').value = cfg.type.key;
    });
    $('#modalClose').addEventListener('click', closeModal);
    modal.addEventListener('click', e => { if (e.target === modal) closeModal(); });
    document.addEventListener('keydown', e => { if (e.key === 'Escape') closeModal(); });
    $('#formBuildingType').addEventListener('change', e => { setType(e.target.value); markSelected(e.target.value); });

    /* =====================================================
       Init
       ===================================================== */
    setType('villa');
    setFinish('gold');
    markSelected('villa');
    requestAnimationFrame(animateCards);
})();
</script>
</body>
</html>
