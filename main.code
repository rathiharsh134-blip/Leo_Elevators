    <!-- Application JavaScript Logic -->
    <script>
        // Set dynamic current year in footer
        document.getElementById('year').textContent = new Date().getFullYear();

        // Mobile Menu Toggle
        const mobileMenuBtn = document.getElementById('mobileMenuBtn');
        const mobileMenu = document.getElementById('mobileMenu');
        mobileMenuBtn.addEventListener('click', () => {
            mobileMenu.classList.toggle('hidden');
        });

        // Dark / Light Theme Toggle Logic
        const themeToggle = document.getElementById('themeToggle');
        const mobileThemeToggle = document.getElementById('mobileThemeToggle');
        
        function toggleTheme() {
            if (document.documentElement.classList.contains('dark')) {
                document.documentElement.classList.remove('dark');
                document.documentElement.classList.add('light');
            } else {
                document.documentElement.classList.remove('light');
                document.documentElement.classList.add('dark');
            }
        }
        themeToggle.addEventListener('click', toggleTheme);
        mobileThemeToggle.addEventListener('click', toggleTheme);

        // Web Audio Synthesizer for Elevator Arrive Chime
        let audioEnabled = true;
        function toggleAudio() {
            audioEnabled = !audioEnabled;
            const soundStatus = document.getElementById('soundStatus');
            if (audioEnabled) {
                soundStatus.innerHTML = '<i class="fa-solid fa-volume-high"></i> CHIME ON';
                soundStatus.className = 'cursor-pointer text-cyan-400';
            } else {
                soundStatus.innerHTML = '<i class="fa-solid fa-volume-xmark"></i> CHIME OFF';
                soundStatus.className = 'cursor-pointer text-slate-500';
            }
        }

        function playArriveChime() {
            if (!audioEnabled) return;
            try {
                const AudioCtx = window.AudioContext || window.webkitAudioContext;
                if (!AudioCtx) return;
                const ctx = new AudioCtx();
                
                // Play double tone chime (E5 -> B5)
                const playTone = (freq, delay, duration) => {
                    setTimeout(() => {
                        const osc = ctx.createOscillator();
                        const gain = ctx.createGain();
                        osc.type = 'sine';
                        osc.frequency.setValueAtTime(freq, ctx.currentTime);
                        gain.gain.setValueAtTime(0.15, ctx.currentTime);
                        gain.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + duration);
                        osc.connect(gain);
                        gain.connect(ctx.destination);
                        osc.start();
                        osc.stop(ctx.currentTime + duration);
                    }, delay);
                };

                playTone(659.25, 0, 0.6);   // E5
                playTone(987.77, 200, 0.8); // B5
            } catch (e) {
                console.log('Audio playback restricted');
            }
        }

        // --- ELEVATOR SHAFT SIMULATOR LOGIC ---
        let currentFloor = 0;
        let isMoving = false;
        const floorNames = ["Grand Lobby (G)", "Innovation Lounge", "Tech Hub", "Corporate Suites", "Penthouse Executive", "Sky Deck"];

        function goToFloor(targetFloor) {
            if (isMoving || targetFloor === currentFloor) return;
            isMoving = true;

            const elevatorCab = document.getElementById('elevatorCab');
            const directionArrow = document.getElementById('directionArrow');
            const floorDisplay = document.getElementById('floorDisplay');
            const statusMessage = document.getElementById('statusMessage');
            const speedReadout = document.getElementById('liftSpeedReadout');
            const doorContainer = document.getElementById('doorContainer');

            // Close doors first if open
            doorContainer.classList.remove('doors-open');

            setTimeout(() => {
                const isGoingUp = targetFloor > currentFloor;
                directionArrow.textContent = isGoingUp ? '▲' : '▼';
                directionArrow.className = isGoingUp ? 'text-emerald-400 font-bold text-3xl animate-bounce' : 'text-cyan-400 font-bold text-3xl animate-bounce';
                statusMessage.textContent = `TRAVELING TO FLOOR ${targetFloor}...`;
                speedReadout.textContent = '2.5 m/s';

                // Highlight COP button
                document.querySelectorAll('.cop-btn').forEach(btn => {
                    btn.classList.remove('border-cyan-500', 'text-cyan-400');
                    if (parseInt(btn.getAttribute('data-floor')) === targetFloor) {
                        btn.classList.add('border-cyan-500', 'text-cyan-400');
                    }
                });

                // Calculate vertical bottom position % (Floor 0 = 0%, Floor 5 = 80%)
                const bottomPercentage = (targetFloor / 5) * 80;
                
                // Set speed transition based on distance
                const distance = Math.abs(targetFloor - currentFloor);
                const duration = Math.max(1.2, distance * 0.8);
                elevatorCab.style.transitionDuration = `${duration}s`;
                elevatorCab.style.bottom = `${bottomPercentage}%`;

                // Intermediate floor update counter
                let stepFloor = currentFloor;
                const interval = setInterval(() => {
                    if (stepFloor !== targetFloor) {
                        stepFloor += isGoingUp ? 1 : -1;
                        floorDisplay.textContent = stepFloor === 0 ? 'G' : stepFloor;
                    } else {
                        clearInterval(interval);
                    }
                }, (duration * 1000) / distance);

                // Arrival callback
                setTimeout(() => {
                    currentFloor = targetFloor;
                    isMoving = false;
                    speedReadout.textContent = '0.0 m/s';
                    directionArrow.className = 'text-slate-600 font-bold text-3xl';
                    statusMessage.textContent = `ARRIVED AT ${floorNames[targetFloor].toUpperCase()}`;
                    
                    playArriveChime();

                    // Open doors automatically on arrival
                    setTimeout(() => {
                        doorContainer.classList.add('doors-open');
                    }, 300);

                }, duration * 1000);

            }, 400);
        }

        function triggerDoors(open) {
            const doorContainer = document.getElementById('doorContainer');
            if (open) {
                doorContainer.classList.add('doors-open');
            } else {
                doorContainer.classList.remove('doors-open');
            }
        }

        function emergencyStop() {
            isMoving = false;
            const speedReadout = document.getElementById('liftSpeedReadout');
            const statusMessage = document.getElementById('statusMessage');
            speedReadout.textContent = '0.0 m/s';
            statusMessage.textContent = 'EMERGENCY BRAKE ENGAGED';
            statusMessage.className = 'text-xs font-mono text-rose-500 font-bold pt-1 animate-pulse';
        }

        // --- CUSTOMIZER & ESTIMATOR LOGIC ---
        let config = {
            basePrice: 22000,
            floors: 4,
            pricePerFloor: 1000,
            finishPrice: 4500,
            finishType: 'gold',
            doorPrice: 0
        };

        function setBuildingType(type, price) {
            config.basePrice = price;
            document.querySelectorAll('.type-btn').forEach(btn => {
                if (btn.getAttribute('data-type') === type) {
                    btn.className = 'type-btn p-3.5 rounded-xl bg-slate-800 border border-cyan-500 text-slate-100 text-left transition-all';
                } else {
                    btn.className = 'type-btn p-3.5 rounded-xl bg-slate-900 border border-slate-800 text-slate-400 text-left transition-all hover:bg-slate-800';
                }
            });
            updateEstimate();
        }

        function setFinish(finish, price) {
            config.finishPrice = price;
            config.finishType = finish;

            const box = document.getElementById('cabinPreviewBox');
            const badge = document.getElementById('finishBadge');

            box.className = `w-full h-64 rounded-2xl border-4 transition-all duration-500 relative flex flex-col justify-between p-4 overflow-hidden style-${finish}`;

            const finishLabels = {
                gold: 'GOLD MIRROR STYLE',
                steel: 'BRUSHED STAINLESS STEEL',
                glass: 'CURVED GLASS WALL',
                walnut: 'WALNUT & MATTE BLACK'
            };
            badge.textContent = finishLabels[finish];

            document.querySelectorAll('.finish-btn').forEach(btn => {
                if (btn.getAttribute('data-finish') === finish) {
                    btn.classList.remove('bg-slate-900', 'border-slate-800');
                    btn.classList.add('bg-slate-800', 'border-cyan-500');
                } else {
                    btn.classList.remove('bg-slate-800', 'border-cyan-500');
                    btn.classList.add('bg-slate-900', 'border-slate-800');
                }
            });

            updateEstimate();
        }

        function updateEstimate() {
            const floorSlider = document.getElementById('floorSlider');
            const floorSliderVal = document.getElementById('floorSliderVal');
            const doorSelect = document.getElementById('doorSelect');

            config.floors = parseInt(floorSlider.value);
            floorSliderVal.textContent = `${config.floors} Stops`;

            config.doorPrice = parseInt(doorSelect.value);

            const floorCost = (config.floors - 2) * config.pricePerFloor;
            const total = config.basePrice + floorCost + config.finishPrice + config.doorPrice;

            document.getElementById('totalPrice').textContent = `$${total.toLocaleString()}`;
            document.getElementById('itemBase').textContent = `$${config.basePrice.toLocaleString()}`;
            document.getElementById('itemFloors').textContent = `$${floorCost.toLocaleString()}`;
            document.getElementById('itemFinish').textContent = `$${config.finishPrice.toLocaleString()}`;
            document.getElementById('itemDoors').textContent = `$${config.doorPrice.toLocaleString()}`;
        }

        function downloadSpecPDF() {
            const specText = `leo ELEVATORS - PROJECT SPECIFICATION SHEET\n` +
                             `==========================================\n` +
                             `Estimated Total: ${document.getElementById('totalPrice').textContent}\n` +
                             `Floors: ${config.floors} Stops\n` +
                             `Interior Style: ${config.finishType.toUpperCase()}\n` +
                             `Safety Directives: EN81, ISO 9001, CE Certified\n` +
                             `Generated on: ${new Date().toLocaleDateString()}`;

            const blob = new Blob([specText], { type: 'text/plain' });
            const link = document.createElement('a');
            link.href = URL.createObjectURL(blob);
            link.download = `leo_Elevators_Spec_${Date.now()}.txt`;
            link.click();
        }

        function prefillContactForm() {
            const msg = document.getElementById('formMessage');
            msg.value = `Hello, I generated a custom quote estimate for a ${config.floors}-floor lift with ${config.finishType.toUpperCase()} interior styling. Estimated total: ${document.getElementById('totalPrice').textContent}. Please provide full technical blueprints.`;
        }

        // --- MODEL GALLERY FILTERING ---
        function filterModels(category) {
            document.querySelectorAll('.model-tab').forEach(tab => {
                if (tab.getAttribute('data-filter') === category) {
                    tab.className = 'model-tab px-5 py-2.5 rounded-xl text-xs font-bold uppercase tracking-wider transition-all bg-gradient-to-r from-indigo-600 to-cyan-600 text-white shadow-lg';
                } else {
                    tab.className = 'model-tab px-5 py-2.5 rounded-xl text-xs font-bold uppercase tracking-wider transition-all glass-panel text-slate-400 hover:text-white';
                }
            });

            document.querySelectorAll('.model-card').forEach(card => {
                if (category === 'all' || card.classList.contains(`model-${category}`)) {
                    card.style.display = 'block';
                } else {
                    card.style.display = 'none';
                }
            });
        }

        // --- FORM SUBMISSION & MODAL ---
        function handleFormSubmit(e) {
            e.preventDefault();
            document.getElementById('successModal').classList.remove('hidden');
        }

        function closeModal() {
            document.getElementById('successModal').classList.add('hidden');
        }
    </script>
</body>
</html>
