<!DOCTYPE html>
<html lang="en" class="dark scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>leo Elevators | Premier Mobility & Architectural Lift Solutions</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Outfit:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        display: ['Outfit', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            indigo: '#4F46E5',
                            cyan: '#06B6D4',
                            emerald: '#10B981',
                            dark: '#090D16',
                            cardDark: '#111827',
                            cardBorderDark: '#1F2937'
                        }
                    },
                    animation: {
                        'pulse-glow': 'pulseGlow 3s infinite ease-in-out',
                        'float': 'float 6s ease-in-out infinite',
                    },
                    keyframes: {
                        pulseGlow: {
                            '0%, 100%': { opacity: 0.4 },
                            '50%': { opacity: 0.8 },
                        },
                        float: {
                            '0%, 100%': { transform: 'translateY(0px)' },
                            '50%': { transform: 'translateY(-10px)' },
                        }
                    }
                }
            }
        }
    </script>
    
    <style>
        /* Custom Customizer & Elevator Styles */
        .glass-panel {
            background: rgba(17, 24, 39, 0.7);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }
        
        .light .glass-panel {
            background: rgba(255, 255, 255, 0.85);
            border: 1px solid rgba(0, 0, 0, 0.08);
        }

        /* Elevator Shaft Grid background pattern */
        .shaft-grid {
            background-size: 20px 20px;
            background-image: 
                linear-gradient(to right, rgba(255, 255, 255, 0.03) 1px, transparent 1px),
                linear-gradient(to bottom, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
        }

        /* Elevator Door Animations */
        .door-left, .door-right {
            transition: transform 0.8s cubic-bezier(0.77, 0, 0.175, 1);
        }
        .doors-open .door-left {
            transform: translateX(-92%);
        }
        .doors-open .door-right {
            transform: translateX(92%);
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #090D16;
        }
        ::-webkit-scrollbar-thumb {
            background: #1E293B;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #06B6D4;
        }

        /* Elevator Cabin Preview Dynamic Textures */
        .style-gold {
            background: linear-gradient(135deg, #2a2012 0%, #574119 50%, #1f170b 100%);
            border-color: #d4af37;
        }
        .style-steel {
            background: linear-gradient(135deg, #1e293b 0%, #334155 50%, #0f172a 100%);
            border-color: #94a3b8;
        }
        .style-glass {
            background: linear-gradient(135deg, #0284c7 0%, #0f172a 60%, #0369a1 100%);
            border-color: #38bdf8;
        }
        .style-walnut {
            background: linear-gradient(135deg, #3f2314 0%, #24140b 50%, #170b05 100%);
            border-color: #854d0e;
        }
    </style>
</head>
<body class="bg-[#090D16] text-slate-100 font-sans antialiased selection:bg-cyan-500 selection:text-white transition-colors duration-300 light:bg-slate-50 light:text-slate-900">

    <!-- Header / Navigation Bar -->
    <header class="sticky top-0 z-50 w-full transition-all duration-300" id="mainHeader">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-20 glass-panel mt-3 rounded-2xl px-6 border border-white/10 shadow-2xl">
                
                <!-- Brand SVG Logo -->
                <a href="#" class="logo-link flex items-center gap-3 group" aria-label="leo Elevators Home">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 280 50" width="220" height="42" class="aesthetic-logo transition-transform duration-300 group-hover:scale-[1.02]">
                        <defs>
                            <linearGradient id="elevatorGradient" x1="0%" y1="100%" x2="100%" y2="0%">
                                <stop offset="0%" stop-color="#4F46E5" />
                                <stop offset="50%" stop-color="#06B6D4" />
                                <stop offset="100%" stop-color="#10B981" />
                            </linearGradient>
                            <filter id="logoGlow" x="-20%" y="-20%" width="140%" height="140%">
                                <feDropShadow dx="0" dy="4" stdDeviation="4" flood-color="#06B6D4" flood-opacity="0.35" />
                            </filter>
                        </defs>
                        <!-- Icon Mark -->
                        <g filter="url(#logoGlow)">
                            <rect x="4" y="4" width="42" height="42" rx="12" fill="url(#elevatorGradient)" />
                            <rect x="13" y="15" width="2.5" height="20" rx="1.25" fill="#FFFFFF" opacity="0.4" />
                            <rect x="34.5" y="15" width="2.5" height="20" rx="1.25" fill="#FFFFFF" opacity="0.4" />
                            <path d="M25 13 L33 22 H28.5 V34 H21.5 V22 H17 Z" fill="#FFFFFF" />
                        </g>
                        <!-- Typography -->
                        <g transform="translate(62, 0)">
                            <text x="0" y="32" font-family="'Outfit', sans-serif" font-weight="900" font-size="22" fill="currentColor" letter-spacing="1.5">
                                LEO
                            </text>
                            <text x="54" y="32" font-family="'Outfit', sans-serif" font-weight="400" font-size="14" fill="url(#elevatorGradient)" letter-spacing="3">
                                ELEVATORS
                            </text>
                        </g>
                    </svg>
                </a>

                <!-- Desktop Navigation Links -->
                <nav class="hidden lg:flex items-center space-x-8 text-sm font-medium">
                    <a href="#hero" class="text-slate-300 hover:text-cyan-400 transition-colors py-1">Home</a>
                    <a href="#simulator" class="text-slate-300 hover:text-cyan-400 transition-colors py-1 flex items-center gap-1.5">
                        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                        Live Simulator
                    </a>
                    <a href="#customizer" class="text-slate-300 hover:text-cyan-400 transition-colors py-1">3D Customizer</a>
                    <a href="#models" class="text-slate-300 hover:text-cyan-400 transition-colors py-1">Elevator Models</a>
                    <a href="#tech" class="text-slate-300 hover:text-cyan-400 transition-colors py-1">Smart Tech</a>
                    <a href="#contact" class="text-slate-300 hover:text-cyan-400 transition-colors py-1">Contact</a>
                </nav>

                <!-- Right Action Cluster -->
                <div class="hidden sm:flex items-center space-x-4">
                    <!-- Theme Toggle Button -->
                    <button id="themeToggle" class="p-2.5 rounded-xl bg-slate-800/80 hover:bg-slate-700 text-cyan-400 border border-slate-700/50 transition-all focus:outline-none" aria-label="Toggle Dark/Light Mode">
                        <i class="fa-solid fa-moon text-lg dark:hidden"></i>
                        <i class="fa-solid fa-sun text-lg hidden dark:block"></i>
                    </button>

                    <!-- Quote Action Button -->
                    <a href="#customizer" class="inline-flex items-center justify-center px-5 py-2.5 rounded-xl text-xs font-bold uppercase tracking-wider text-white bg-gradient-to-r from-indigo-600 via-cyan-600 to-emerald-500 hover:opacity-95 shadow-lg shadow-cyan-500/20 transition-all hover:scale-[1.02]">
                        <i class="fa-solid fa-calculator mr-2"></i> Instant Quote
                    </a>
                </div>

                <!-- Mobile Hamburger Button -->
                <button id="mobileMenuBtn" class="lg:hidden p-2 rounded-xl text-slate-300 hover:bg-slate-800 focus:outline-none" aria-label="Toggle Mobile Menu">
                    <i class="fa-solid fa-bars text-xl"></i>
                </button>
            </div>
        </div>

        <!-- Mobile Dropdown Menu -->
        <div id="mobileMenu" class="hidden lg:hidden max-w-7xl mx-auto px-4 mt-2">
            <div class="glass-panel rounded-2xl p-6 space-y-4 border border-white/10 shadow-2xl flex flex-col">
                <a href="#hero" class="text-slate-200 hover:text-cyan-400 font-medium text-base py-1">Home</a>
                <a href="#simulator" class="text-slate-200 hover:text-cyan-400 font-medium text-base py-1">Live Shaft Simulator</a>
                <a href="#customizer" class="text-slate-200 hover:text-cyan-400 font-medium text-base py-1">Cabin Customizer</a>
                <a href="#models" class="text-slate-200 hover:text-cyan-400 font-medium text-base py-1">Elevator Models</a>
                <a href="#tech" class="text-slate-200 hover:text-cyan-400 font-medium text-base py-1">Smart Tech & Safety</a>
                <a href="#contact" class="text-slate-200 hover:text-cyan-400 font-medium text-base py-1">Contact Us</a>
                
                <div class="pt-4 border-t border-slate-800 flex items-center justify-between">
                    <span class="text-xs text-slate-400">Switch Theme</span>
                    <button id="mobileThemeToggle" class="px-4 py-2 rounded-xl bg-slate-800 text-cyan-400 text-xs font-semibold">
                        Toggle Light/Dark
                    </button>
                </div>
                <a href="#customizer" class="w-full text-center py-3 rounded-xl font-bold text-xs uppercase tracking-wider text-white bg-gradient-to-r from-indigo-600 to-emerald-500">
                    Get Custom Quote
                </a>
            </div>
        </div>
    </header>

    <!-- Hero Section -->
    <section id="hero" class="relative pt-12 pb-24 md:pt-20 md:pb-32 overflow-hidden">
        <!-- Ambient Radial Background Glows -->
        <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-indigo-600/15 rounded-full blur-[140px] pointer-events-none"></div>
        <div class="absolute top-1/3 right-10 w-[400px] h-[400px] bg-cyan-500/15 rounded-full blur-[120px] pointer-events-none"></div>

        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
                
                <!-- Hero Left Copy -->
                <div class="lg:col-span-7 space-y-8 text-center lg:text-left">
                    <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full glass-panel text-xs font-semibold text-cyan-400 border border-cyan-500/30">
                        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
                        Next-Gen Mobility Systems & Artificial Intelligence Drive
                    </div>

                    <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight leading-[1.15]">
                        Elevating Architectural <br class="hidden sm:block"/>
                        <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-400 via-cyan-400 to-emerald-400">
                            Luxury & Engineering Precision
                        </span>
                    </h1>

                    <p class="text-slate-400 text-base sm:text-lg max-w-2xl mx-auto lg:mx-0 leading-relaxed">
                        Smart, sustainable, ultra-smooth elevator systems designed for modern residential villas, luxury high-rises, and industrial towers. Powered by AI predictive maintenance and zero-energy regenerative drives.
                    </p>

                    <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 pt-2">
                        <a href="#customizer" class="w-full sm:w-auto px-8 py-4 rounded-xl font-bold text-sm text-white bg-gradient-to-r from-indigo-600 via-cyan-600 to-emerald-500 hover:opacity-90 shadow-xl shadow-cyan-500/25 transition-all transform hover:-translate-y-0.5 text-center">
                            <i class="fa-solid fa-wand-magic-sparkles mr-2"></i> Configure Custom Lift
                        </a>
                        <a href="#simulator" class="w-full sm:w-auto px-8 py-4 rounded-xl font-bold text-sm text-slate-200 glass-panel hover:bg-slate-800/80 transition-all border border-slate-700/60 text-center">
                            <i class="fa-solid fa-play mr-2 text-cyan-400"></i> Try Lift Simulator
                        </a>
                    </div>

                    <!-- Trust Badges -->
                    <div class="pt-6 border-t border-slate-800/80 flex flex-wrap items-center justify-center lg:justify-start gap-6 text-xs text-slate-400">
                        <span class="flex items-center gap-2"><i class="fa-solid fa-shield-halved text-emerald-400 text-base"></i> ISO 9001 Certified</span>
                        <span class="flex items-center gap-2"><i class="fa-solid fa-bolt text-amber-400 text-base"></i> Class A+++ Eco Drive</span>
                        <span class="flex items-center gap-2"><i class="fa-solid fa-building text-cyan-400 text-base"></i> EN81 Safety Compliance</span>
                    </div>
                </div>

                <!-- Hero Visual Showcase Card -->
                <div class="lg:col-span-5 relative">
                    <div class="relative mx-auto max-w-md lg:max-w-none glass-panel p-6 rounded-3xl border border-slate-700/50 shadow-2xl overflow-hidden group">
                        
                        <div class="relative h-[420px] rounded-2xl overflow-hidden bg-slate-900 flex items-center justify-center">
                            <img src="https://images.unsplash.com/photo-1541888946425-d0fbb186a5b3?auto=format&fit=crop&w=1000&q=80" alt="Luxury Elevator Architecture" class="w-full h-full object-cover opacity-80 group-hover:scale-105 transition-transform duration-700" onerror="this.src='https://placehold.co/800x1000/1e293b/ffffff?text=LEO+Elevators+Luxury+Tower'">
                            
                            <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/20 to-transparent"></div>

                            <!-- Floating Tech Overlay Tag -->
                            <div class="absolute top-4 left-4 glass-panel px-4 py-2 rounded-xl border border-white/20 text-xs font-semibold flex items-center gap-2">
                                <i class="fa-solid fa-gauge-high text-cyan-400"></i> Up to 6.0 m/s Speed
                            </div>

                            <!-- Live Audio / Gear Dynamic Indicator -->
                            <div class="absolute bottom-6 left-6 right-6 glass-panel p-4 rounded-xl border border-white/10 space-y-2">
                                <div class="flex items-center justify-between text-xs">
                                    <span class="text-cyan-400 font-mono font-semibold">LEO SYNAPSE AI ENGINE</span>
                                    <span class="text-emerald-400 font-semibold"><i class="fa-solid fa-circle text-[8px] mr-1"></i> OPTIMAL</span>
                                </div>
                                <div class="w-full bg-slate-800 h-2 rounded-full overflow-hidden">
                                    <div class="bg-gradient-to-r from-indigo-500 via-cyan-400 to-emerald-400 h-full w-[88%] animate-pulse"></div>
                                </div>
                                <div class="flex justify-between text-[11px] text-slate-400 font-mono">
                                    <span>Vibration: 0.01m/s²</span>
                                    <span>Energy Recycled: 34.2 kW</span>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>

            </div>

            <!-- Stats Ticker Bar -->
            <div class="mt-16 grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6">
                <div class="glass-panel p-6 rounded-2xl border border-slate-800 text-center hover:border-cyan-500/40 transition-colors">
                    <div class="font-display text-3xl sm:text-4xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-indigo-400 to-cyan-400">5,000+</div>
                    <div class="text-xs sm:text-sm text-slate-400 font-medium mt-1">Global Installations</div>
                </div>
                <div class="glass-panel p-6 rounded-2xl border border-slate-800 text-center hover:border-cyan-500/40 transition-colors">
                    <div class="font-display text-3xl sm:text-4xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-emerald-400">99.98%</div>
                    <div class="text-xs sm:text-sm text-slate-400 font-medium mt-1">Operational Uptime</div>
                </div>
                <div class="glass-panel p-6 rounded-2xl border border-slate-800 text-center hover:border-cyan-500/40 transition-colors">
                    <div class="font-display text-3xl sm:text-4xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-indigo-400">15 Mins</div>
                    <div class="text-xs sm:text-sm text-slate-400 font-medium mt-1">24/7 Rapid Response</div>
                </div>
                <div class="glass-panel p-6 rounded-2xl border border-slate-800 text-center hover:border-cyan-500/40 transition-colors">
                    <div class="font-display text-3xl sm:text-4xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-indigo-400 to-emerald-400">18+</div>
                    <div class="text-xs sm:text-sm text-slate-400 font-medium mt-1">Countries Served</div>
                </div>
            </div>
        </div>
    </section>

    <!-- Interactive Elevator Shaft Simulator Section -->
    <section id="simulator" class="py-20 relative bg-slate-950/60 border-y border-slate-800/80">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            
            <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
                <span class="text-cyan-400 text-xs font-bold uppercase tracking-widest px-3.5 py-1.5 rounded-full glass-panel border border-cyan-500/30">
                    Interactive Tech Experience
                </span>
                <h2 class="font-display text-3xl sm:text-4xl font-extrabold">
                    Live Shaft & Floor Call Simulator
                </h2>
                <p class="text-slate-400 text-sm sm:text-base">
                    Test our ultra-smooth leveling algorithms and interactive floor dispatch control panel in real time.
                </p>
            </div>

            <!-- Simulator Card Container -->
            <div class="glass-panel rounded-3xl p-6 sm:p-8 border border-slate-800 shadow-2xl max-w-5xl mx-auto">
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
                    
                    <!-- Shaft Graphic Tower (Left Column) -->
                    <div class="lg:col-span-7 bg-slate-900 rounded-2xl p-6 border border-slate-800 shaft-grid relative min-h-[460px] flex flex-col justify-between overflow-hidden">
                        
                        <!-- Shaft Top Overhead Machinery Room -->
                        <div class="flex items-center justify-between border-b border-slate-800 pb-3 z-10 bg-slate-900/90 px-2 rounded-lg">
                            <div class="flex items-center gap-2">
                                <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
                                <span class="text-xs font-mono text-slate-300">LEO GEARLESS TRACTION MOTOR #01</span>
                            </div>
                            <span class="text-[11px] font-mono text-cyan-400" id="liftSpeedReadout">0.0 m/s</span>
                        </div>

                        <!-- Elevator Shaft Track Area -->
                        <div class="relative flex-1 my-4 shaft-track-container" id="shaftTrack">
                            
                            <!-- Floor Level Guides (5 to G) -->
                            <div class="absolute inset-0 flex flex-col justify-between pointer-events-none py-2 text-xs font-mono text-slate-600">
                                <div class="border-b border-dashed border-slate-800 flex justify-between items-center pb-1">
                                    <span>FL 5 - Sky Deck</span>
                                    <span class="text-[10px] text-slate-700">20.0m</span>
                                </div>
                                <div class="border-b border-dashed border-slate-800 flex justify-between items-center pb-1">
                                    <span>FL 4 - Penthouse Executive</span>
                                    <span class="text-[10px] text-slate-700">16.0m</span>
                                </div>
                                <div class="border-b border-dashed border-slate-800 flex justify-between items-center pb-1">
                                    <span>FL 3 - Corporate Suites</span>
                                    <span class="text-[10px] text-slate-700">12.0m</span>
                                </div>
                                <div class="border-b border-dashed border-slate-800 flex justify-between items-center pb-1">
                                    <span>FL 2 - Tech Hub</span>
                                    <span class="text-[10px] text-slate-700">8.0m</span>
                                </div>
                                <div class="border-b border-dashed border-slate-800 flex justify-between items-center pb-1">
                                    <span>FL 1 - Innovation Lounge</span>
                                    <span class="text-[10px] text-slate-700">4.0m</span>
                                </div>
                                <div class="border-b border-dashed border-slate-800 flex justify-between items-center pb-1">
                                    <span>FL 0 - Grand Lobby (G)</span>
                                    <span class="text-[10px] text-slate-700">0.0m</span>
                                </div>
                            </div>

                            <!-- Animated Elevator Cabin -->
                            <div id="elevatorCab" class="absolute left-1/2 -translate-x-1/2 w-48 h-16 sm:h-20 bg-slate-800 rounded-xl border-2 border-cyan-500 shadow-lg shadow-cyan-500/20 transition-all duration-700 ease-in-out flex items-center justify-between px-2 overflow-hidden" style="bottom: 0%;">
                                
                                <!-- Internal Cabin Ambient LED Light -->
                                <div class="absolute inset-0 bg-cyan-500/10 pointer-events-none"></div>

                                <!-- Animated Doors Container -->
                                <div class="relative w-full h-full rounded-lg bg-slate-950 flex overflow-hidden border border-slate-700" id="doorContainer">
                                    <!-- Left Door Panel -->
                                    <div class="door-left w-1/2 h-full bg-gradient-to-r from-slate-800 to-slate-700 border-r border-cyan-500/50 flex items-center justify-end pr-1">
                                        <div class="w-1 h-8 bg-slate-600 rounded-full"></div>
                                    </div>
                                    <!-- Right Door Panel -->
                                    <div class="door-right w-1/2 h-full bg-gradient-to-l from-slate-800 to-slate-700 border-l border-cyan-500/50 flex items-center justify-start pl-1">
                                        <div class="w-1 h-8 bg-slate-600 rounded-full"></div>
                                    </div>

                                    <!-- Inside Cabin Silhouette Visible when doors open -->
                                    <div class="absolute inset-0 -z-10 bg-slate-900 flex items-center justify-center text-slate-400 text-xs font-mono">
                                        <i class="fa-solid fa-user-tie text-cyan-400 mr-1"></i> PASSENGERS
                                    </div>
                                </div>

                            </div>

                        </div>

                        <!-- Shaft Bottom Buffer Info -->
                        <div class="flex items-center justify-between border-t border-slate-800 pt-3 text-[11px] font-mono text-slate-400 z-10 bg-slate-900/90 px-2 rounded-lg">
                            <span>HYDRAULIC BUFFER: READY</span>
                            <span class="text-emerald-400"><i class="fa-solid fa-lock text-[10px] mr-1"></i> SAFETY GEAR ENGAGED</span>
                        </div>

                    </div>

                    <!-- Elevator Control Panel (Right Column) -->
                    <div class="lg:col-span-5 bg-slate-900/90 rounded-2xl p-6 border border-slate-800 flex flex-col items-center justify-center space-y-6">
                        
                        <!-- Digital LED Display Box -->
                        <div class="w-full bg-black p-4 rounded-xl border-2 border-slate-800 text-center space-y-1 shadow-inner">
                            <div class="flex items-center justify-between text-xs font-mono text-slate-500 border-b border-slate-800 pb-2">
                                <span>DIGITAL COP DISPLAY</span>
                                <span id="soundStatus" class="cursor-pointer text-cyan-400" onclick="toggleAudio()"><i class="fa-solid fa-volume-high"></i> CHIME ON</span>
                            </div>
                            
                            <div class="flex items-center justify-center gap-4 pt-2">
                                <span id="directionArrow" class="text-slate-600 font-bold text-3xl">▲</span>
                                <span id="floorDisplay" class="font-mono text-5xl font-black text-cyan-400 tracking-wider">0</span>
                            </div>

                            <div id="statusMessage" class="text-xs font-mono text-emerald-400 pt-1">
                                STATIONARY AT GRAND LOBBY
                            </div>
                        </div>

                        <!-- Floor Call Buttons Grid (Floor 0 to 5) -->
                        <div class="w-full space-y-3">
                            <label class="text-xs font-semibold text-slate-400 uppercase tracking-wider block text-center">Select Destination Floor</label>
                            
                            <div class="grid grid-cols-3 gap-3">
                                <button onclick="goToFloor(5)" class="cop-btn h-14 rounded-xl bg-slate-800 hover:bg-slate-700 border border-slate-700 text-slate-200 font-bold text-lg font-mono flex flex-col items-center justify-center transition-all focus:ring-2 focus:ring-cyan-500" data-floor="5">
                                    5
                                    <span class="text-[9px] font-sans font-normal text-slate-400">Sky Deck</span>
                                </button>
                                <button onclick="goToFloor(4)" class="cop-btn h-14 rounded-xl bg-slate-800 hover:bg-slate-700 border border-slate-700 text-slate-200 font-bold text-lg font-mono flex flex-col items-center justify-center transition-all focus:ring-2 focus:ring-cyan-500" data-floor="4">
                                    4
                                    <span class="text-[9px] font-sans font-normal text-slate-400">Penthouse</span>
                                </button>
                                <button onclick="goToFloor(3)" class="cop-btn h-14 rounded-xl bg-slate-800 hover:bg-slate-700 border border-slate-700 text-slate-200 font-bold text-lg font-mono flex flex-col items-center justify-center transition-all focus:ring-2 focus:ring-cyan-500" data-floor="3">
                                    3
                                    <span class="text-[9px] font-sans font-normal text-slate-400">Corporate</span>
                                </button>
                                <button onclick="goToFloor(2)" class="cop-btn h-14 rounded-xl bg-slate-800 hover:bg-slate-700 border border-slate-700 text-slate-200 font-bold text-lg font-mono flex flex-col items-center justify-center transition-all focus:ring-2 focus:ring-cyan-500" data-floor="2">
                                    2
                                    <span class="text-[9px] font-sans font-normal text-slate-400">Tech Hub</span>
                                </button>
                                <button onclick="goToFloor(1)" class="cop-btn h-14 rounded-xl bg-slate-800 hover:bg-slate-700 border border-slate-700 text-slate-200 font-bold text-lg font-mono flex flex-col items-center justify-center transition-all focus:ring-2 focus:ring-cyan-500" data-floor="1">
                                    1
                                    <span class="text-[9px] font-sans font-normal text-slate-400">Lounge</span>
                                </button>
                                <button onclick="goToFloor(0)" class="cop-btn h-14 rounded-xl bg-slate-800 hover:bg-slate-700 border border-cyan-500/80 text-cyan-400 font-bold text-lg font-mono flex flex-col items-center justify-center transition-all focus:ring-2 focus:ring-cyan-500 shadow-sm shadow-cyan-500/30" data-floor="0">
                                    G
                                    <span class="text-[9px] font-sans font-normal text-slate-400">Lobby</span>
                                </button>
                            </div>
                        </div>

                        <!-- Door & Emergency Buttons -->
                        <div class="w-full grid grid-cols-3 gap-3 pt-2">
                            <button onclick="triggerDoors(true)" class="py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 font-semibold text-xs border border-slate-700 flex items-center justify-center gap-1.5">
                                <i class="fa-solid fa-arrows-left-right text-cyan-400"></i> Open
                            </button>
                            <button onclick="triggerDoors(false)" class="py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 font-semibold text-xs border border-slate-700 flex items-center justify-center gap-1.5">
                                <i class="fa-solid fa-compress text-cyan-400"></i> Close
                            </button>
                            <button onclick="emergencyStop()" class="py-2.5 rounded-xl bg-rose-950/80 hover:bg-rose-900 text-rose-300 font-bold text-xs border border-rose-800 flex items-center justify-center gap-1.5">
                                <i class="fa-solid fa-triangle-exclamation text-rose-400"></i> STOP
                            </button>
                        </div>

                    </div>

                </div>
            </div>

        </div>
    </section>

    <!-- Interactive Cabin Customizer & Price Estimator Section -->
    <section id="customizer" class="py-24 relative">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            
            <div class="text-center max-w-3xl mx-auto mb-16 space-y-4">
                <span class="text-emerald-400 text-xs font-bold uppercase tracking-widest px-3.5 py-1.5 rounded-full glass-panel border border-emerald-500/30">
                    Real-time Configurator
                </span>
                <h2 class="font-display text-3xl sm:text-4xl font-extrabold">
                    Cabin Customizer & Instant Estimator
                </h2>
                <p class="text-slate-400 text-sm sm:text-base">
                    Tailor materials, lighting, doors, and floor capacity to generate an accurate architectural cost estimate.
                </p>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
                
                <!-- Customizer Options Column (Left) -->
                <div class="lg:col-span-6 space-y-6 glass-panel p-6 sm:p-8 rounded-3xl border border-slate-800">
                    
                    <!-- Building Application Type -->
                    <div>
                        <label class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-3">1. Building Application</label>
                        <div class="grid grid-cols-2 gap-3">
                            <button type="button" onclick="setBuildingType('villa', 22000)" class="type-btn p-3.5 rounded-xl bg-slate-800 border border-cyan-500 text-slate-100 text-left transition-all" data-type="villa">
                                <div class="font-bold text-sm"><i class="fa-solid fa-house-chimney text-cyan-400 mr-1.5"></i> Luxury Villa</div>
                                <div class="text-[11px] text-slate-400 mt-1">Residential 2-4 Stop</div>
                            </button>
                            <button type="button" onclick="setBuildingType('commercial', 42000)" class="type-btn p-3.5 rounded-xl bg-slate-900 border border-slate-800 text-slate-400 text-left transition-all hover:bg-slate-800" data-type="commercial">
                                <div class="font-bold text-sm"><i class="fa-solid fa-building text-indigo-400 mr-1.5"></i> Commercial Tower</div>
                                <div class="text-[11px] text-slate-400 mt-1">High Speed Passenger</div>
                            </button>
                            <button type="button" onclick="setBuildingType('heavy', 55000)" class="type-btn p-3.5 rounded-xl bg-slate-900 border border-slate-800 text-slate-400 text-left transition-all hover:bg-slate-800" data-type="heavy">
                                <div class="font-bold text-sm"><i class="fa-solid fa-truck-ramp-box text-amber-400 mr-1.5"></i> Heavy Industrial</div>
                                <div class="text-[11px] text-slate-400 mt-1">Cargo & Goods Lift</div>
                            </button>
                            <button type="button" onclick="setBuildingType('panoramic', 38000)" class="type-btn p-3.5 rounded-xl bg-slate-900 border border-slate-800 text-slate-400 text-left transition-all hover:bg-slate-800" data-type="panoramic">
                                <div class="font-bold text-sm"><i class="fa-solid fa-eye text-emerald-400 mr-1.5"></i> Glass Panoramic</div>
                                <div class="text-[11px] text-slate-400 mt-1">Observation Aesthetic</div>
                            </button>
                        </div>
                    </div>

                    <!-- Number of Floors Slider -->
                    <div class="space-y-2 pt-2">
                        <div class="flex justify-between items-center text-xs font-bold uppercase tracking-wider text-slate-300">
                            <span>2. Number of Floors / Stops</span>
                            <span id="floorSliderVal" class="text-cyan-400 font-mono text-base font-extrabold">4 Stops</span>
                        </div>
                        <input type="range" id="floorSlider" min="2" max="30" value="4" oninput="updateEstimate()" class="w-full h-2 bg-slate-800 rounded-lg appearance-none cursor-pointer accent-cyan-400">
                        <div class="flex justify-between text-[10px] text-slate-500 font-mono">
                            <span>2 Floors</span>
                            <span>15 Floors</span>
                            <span>30 Floors</span>
                        </div>
                    </div>

                    <!-- Interior Cabin Finishes -->
                    <div>
                        <label class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-3">3. Cabin Interior Finishes</label>
                        <div class="grid grid-cols-2 gap-3">
                            <button type="button" onclick="setFinish('gold', 4500)" class="finish-btn p-3 rounded-xl bg-slate-800 border border-amber-500/80 text-left flex items-center gap-3 transition-all" data-finish="gold">
                                <span class="w-8 h-8 rounded-lg bg-amber-500/20 border border-amber-400 flex items-center justify-center text-amber-400"><i class="fa-solid fa-gem"></i></span>
                                <div>
                                    <div class="font-semibold text-xs text-slate-200">Gold Mirror & LED</div>
                                    <div class="text-[10px] text-amber-400">+$4,500</div>
                                </div>
                            </button>

                            <button type="button" onclick="setFinish('steel', 0)" class="finish-btn p-3 rounded-xl bg-slate-900 border border-slate-800 text-left flex items-center gap-3 transition-all hover:bg-slate-800" data-finish="steel">
                                <span class="w-8 h-8 rounded-lg bg-slate-700 border border-slate-500 flex items-center justify-center text-slate-300"><i class="fa-solid fa-layer-group"></i></span>
                                <div>
                                    <div class="font-semibold text-xs text-slate-200">Brushed Stainless</div>
                                    <div class="text-[10px] text-slate-400">Included</div>
                                </div>
                            </button>

                            <button type="button" onclick="setFinish('glass', 6500)" class="finish-btn p-3 rounded-xl bg-slate-900 border border-slate-800 text-left flex items-center gap-3 transition-all hover:bg-slate-800" data-finish="glass">
                                <span class="w-8 h-8 rounded-lg bg-sky-500/20 border border-sky-400 flex items-center justify-center text-sky-400"><i class="fa-solid fa-glasses"></i></span>
                                <div>
                                    <div class="font-semibold text-xs text-slate-200">Curved Glass Wall</div>
                                    <div class="text-[10px] text-cyan-400">+$6,500</div>
                                </div>
                            </button>

                            <button type="button" onclick="setFinish('walnut', 3200)" class="finish-btn p-3 rounded-xl bg-slate-900 border border-slate-800 text-left flex items-center gap-3 transition-all hover:bg-slate-800" data-finish="walnut">
                                <span class="w-8 h-8 rounded-lg bg-amber-900/30 border border-amber-800 flex items-center justify-center text-amber-600"><i class="fa-solid fa-tree"></i></span>
                                <div>
                                    <div class="font-semibold text-xs text-slate-200">Walnut & Matte Black</div>
                                    <div class="text-[10px] text-amber-500">+$3,200</div>
                                </div>
                            </button>
                        </div>
                    </div>

                    <!-- Door Style -->
                    <div>
                        <label class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-2">4. Door Mechanism Style</label>
                        <select id="doorSelect" onchange="updateEstimate()" class="w-full bg-slate-900 border border-slate-800 rounded-xl px-4 py-3 text-sm text-slate-200 focus:outline-none focus:border-cyan-500">
                            <option value="0">Automatic Center Opening (Standard)</option>
                            <option value="1500">Telescopic Side Sliding (Compact Shaft +$1,500)</option>
                            <option value="3000">Frameless Glass Automatic Doors (+$3,000)</option>
                        </select>
                    </div>

                </div>

                <!-- Customizer Visual Preview & Dynamic Estimate Box (Right) -->
                <div class="lg:col-span-6 space-y-6">
                    
                    <!-- Dynamic Cabin Graphic Canvas Preview -->
                    <div class="glass-panel p-6 rounded-3xl border border-slate-800 text-center relative overflow-hidden">
                        <div class="flex items-center justify-between text-xs font-mono text-slate-400 mb-4">
                            <span><i class="fa-solid fa-cube text-cyan-400 mr-1"></i> LIVE INTERIOR PREVIEW</span>
                            <span id="finishBadge" class="text-amber-400 font-semibold">GOLD MIRROR STYLE</span>
                        </div>

                        <!-- Elevator Cabin Box Graphic View -->
                        <div id="cabinPreviewBox" class="w-full h-64 rounded-2xl border-4 transition-all duration-500 relative flex flex-col justify-between p-4 overflow-hidden style-gold">
                            
                            <!-- Ceiling LED Lighting Strip -->
                            <div class="w-full h-3 rounded-full bg-white shadow-lg shadow-white/80 transition-all" id="ceilingLight"></div>

                            <!-- Back Wall Mirror & Handrail Visual -->
                            <div class="flex-1 my-3 border border-white/20 rounded-xl bg-white/5 backdrop-blur-sm relative flex items-center justify-center">
                                <div class="w-3/4 h-1 bg-slate-300/60 rounded-full shadow-md"></div>
                                <span class="absolute top-2 text-[10px] font-mono text-white/50 tracking-widest">LEO ARCHITECTURAL</span>
                            </div>

                            <!-- Floor Slab Visual -->
                            <div class="w-full h-5 bg-gradient-to-r from-slate-900 via-slate-800 to-slate-900 rounded-lg border-t border-white/20 flex items-center justify-center">
                                <div class="w-12 h-1 bg-cyan-400/80 rounded-full"></div>
                            </div>
                        </div>

                        <p class="text-[11px] text-slate-500 mt-3">Visual representation only. Exact textures & handrails subject to custom architectural drawings.</p>
                    </div>

                    <!-- Dynamic Cost Breakdown Card -->
                    <div class="glass-panel p-6 sm:p-8 rounded-3xl border border-cyan-500/30 bg-gradient-to-br from-slate-900/90 to-indigo-950/40 shadow-xl space-y-6">
                        <div class="flex items-center justify-between border-b border-slate-800 pb-4">
                            <div>
                                <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400">Estimated Project Investment</h3>
                                <div id="totalPrice" class="font-display text-4xl sm:text-5xl font-black text-transparent bg-clip-text bg-gradient-to-r from-indigo-400 via-cyan-400 to-emerald-400 mt-1">
                                    $30,500
                                </div>
                            </div>
                            <span class="px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/30 text-xs font-semibold">
                                <i class="fa-solid fa-check text-[10px] mr-1"></i> Budget Estimate
                            </span>
                        </div>

                        <!-- Itemized List -->
                        <div class="space-y-2 text-xs font-mono text-slate-300">
                            <div class="flex justify-between">
                                <span class="text-slate-400">Base Equipment:</span>
                                <span id="itemBase">$22,000</span>
                            </div>
                            <div class="flex justify-between">
                                <span class="text-slate-400">Floor Shaft Expansion:</span>
                                <span id="itemFloors">$4,000</span>
                            </div>
                            <div class="flex justify-between">
                                <span class="text-slate-400">Interior Styling Package:</span>
                                <span id="itemFinish">$4,500</span>
                            </div>
                            <div class="flex justify-between">
                                <span class="text-slate-400">Door System:</span>
                                <span id="itemDoors">$0</span>
                            </div>
                        </div>

                        <!-- Actions -->
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2">
                            <button onclick="downloadSpecPDF()" class="py-3 px-4 rounded-xl glass-panel hover:bg-slate-800 text-xs font-bold text-slate-200 border border-slate-700 transition-all flex items-center justify-center gap-2">
                                <i class="fa-solid fa-file-arrow-down text-cyan-400"></i> Save Spec Sheet
                            </button>
                            <a href="#contact" onclick="prefillContactForm()" class="py-3 px-4 rounded-xl bg-gradient-to-r from-indigo-600 to-emerald-500 hover:opacity-90 text-xs font-bold text-white transition-all text-center flex items-center justify-center gap-2">
                                <i class="fa-solid fa-paper-plane"></i> Lock In Quote
                            </a>
                        </div>
                    </div>

                </div>

            </div>

        </div>
    </section>

    <!-- Elevator Models Gallery Section -->
    <section id="models" class="py-24 bg-slate-950/60 border-t border-slate-800">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            
            <div class="text-center max-w-3xl mx-auto mb-12 space-y-4">
                <span class="text-indigo-400 text-xs font-bold uppercase tracking-widest px-3.5 py-1.5 rounded-full glass-panel border border-indigo-500/30">
                    Product Portfolio
                </span>
                <h2 class="font-display text-3xl sm:text-4xl font-extrabold">
                    Flagship Elevator Models
                </h2>
                <p class="text-slate-400 text-sm sm:text-base">
                    From compact shaftless home lifts to high-speed skyscraper elevators.
                </p>
            </div>

            <!-- Filter Tabs -->
            <div class="flex flex-wrap items-center justify-center gap-3 mb-12">
                <button onclick="filterModels('all')" class="model-tab px-5 py-2.5 rounded-xl text-xs font-bold uppercase tracking-wider transition-all bg-gradient-to-r from-indigo-600 to-cyan-600 text-white shadow-lg" data-filter="all">All Models</button>
                <button onclick="filterModels('residential')" class="model-tab px-5 py-2.5 rounded-xl text-xs font-bold uppercase tracking-wider transition-all glass-panel text-slate-400 hover:text-white" data-filter="residential">Residential</button>
                <button onclick="filterModels('commercial')" class="model-tab px-5 py-2.5 rounded-xl text-xs font-bold uppercase tracking-wider transition-all glass-panel text-slate-400 hover:text-white" data-filter="commercial">Commercial</button>
                <button onclick="filterModels('industrial')" class="model-tab px-5 py-2.5 rounded-xl text-xs font-bold uppercase tracking-wider transition-all glass-panel text-slate-400 hover:text-white" data-filter="industrial">Industrial</button>
            </div>

            <!-- Models Cards Grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8" id="modelsGrid">
                
                <!-- Model 1 -->
                <div class="model-card model-residential glass-panel rounded-3xl overflow-hidden border border-slate-800 hover:border-cyan-500/50 transition-all duration-300 group">
                    <div class="h-56 relative overflow-hidden bg-slate-900">
                        <img src="https://images.unsplash.com/photo-1600585154340-be6161a56a0c?auto=format&fit=crop&w=600&q=80" alt="LEO Villa-Lux" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" onerror="this.src='https://placehold.co/600x400/1e293b/ffffff?text=LEO+Villa-Lux'">
                        <span class="absolute top-4 left-4 px-3 py-1 rounded-full bg-indigo-600 text-white text-[10px] font-bold uppercase tracking-wider">Residential</span>
                    </div>
                    <div class="p-6 space-y-4">
                        <h3 class="font-display text-xl font-bold">LEO Villa-Lux</h3>
                        <p class="text-slate-400 text-xs leading-relaxed">Compact gearless home elevator with zero pit requirements. Perfect for 2 to 4-story luxury private residences.</p>
                        
                        <div class="space-y-2 border-t border-slate-800 pt-4 text-xs font-mono text-slate-300">
                            <div class="flex justify-between">
                                <span class="text-slate-500">Speed:</span>
                                <span>1.0 m/s</span>
                            </div>
                            <div class="flex justify-between">
                                <span class="text-slate-500">Capacity:</span>
                                <span>4 - 6 Persons (450 kg)</span>
                            </div>
                            <div class="flex justify-between">
                                <span class="text-slate-500">Drive:</span>
                                <span class="text-emerald-400">Eco Silent Belt</span>
                            </div>
                        </div>

                        <a href="#customizer" class="block w-full text-center py-2.5 rounded-xl glass-panel hover:bg-slate-800 text-xs font-bold text-cyan-400 border border-cyan-500/30 transition-all">
                            Configure This Lift
                        </a>
                    </div>
                </div>

                <!-- Model 2 -->
                <div class="model-card model-commercial glass-panel rounded-3xl overflow-hidden border border-slate-800 hover:border-cyan-500/50 transition-all duration-300 group">
                    <div class="h-56 relative overflow-hidden bg-slate-900">
                        <img src="https://images.unsplash.com/photo-1486406146926-c627a92ad1ab?auto=format&fit=crop&w=600&q=80" alt="LEO SkyPass 500" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" onerror="this.src='https://placehold.co/600x400/1e293b/ffffff?text=LEO+SkyPass'">
                        <span class="absolute top-4 left-4 px-3 py-1 rounded-full bg-cyan-600 text-white text-[10px] font-bold uppercase tracking-wider">Commercial</span>
                    </div>
                    <div class="p-6 space-y-4">
                        <h3 class="font-display text-xl font-bold">LEO SkyPass 500</h3>
                        <p class="text-slate-400 text-xs leading-relaxed">Ultra high-speed commercial elevator for high-rise corporate towers and luxury hotel destinations.</p>
                        
                        <div class="space-y-2 border-t border-slate-800 pt-4 text-xs font-mono text-slate-300">
                            <div class="flex justify-between">
                                <span class="text-slate-500">Speed:</span>
                                <span>Up to 6.0 m/s</span>
                            </div>
                            <div class="flex justify-between">
                                <span class="text-slate-500">Capacity:</span>
                                <span>16 - 24 Persons (1600 kg)</span>
                            </div>
                            <div class="flex justify-between">
                                <span class="text-slate-500">Drive:</span>
                                <span class="text-emerald-400">Synapse AI Traction</span>
                            </div>
                        </div>

                        <a href="#customizer" class="block w-full text-center py-2.5 rounded-xl glass-panel hover:bg-slate-800 text-xs font-bold text-cyan-400 border border-cyan-500/30 transition-all">
                            Configure This Lift
                        </a>
                    </div>
                </div>

                <!-- Model 3 -->
                <div class="model-card model-industrial glass-panel rounded-3xl overflow-hidden border border-slate-800 hover:border-cyan-500/50 transition-all duration-300 group">
                    <div class="h-56 relative overflow-hidden bg-slate-900">
                        <img src="https://images.unsplash.com/photo-1581091226825-a6a2a5aee158?auto=format&fit=crop&w=600&q=80" alt="LEO Titan Cargo" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" onerror="this.src='https://placehold.co/600x400/1e293b/ffffff?text=LEO+Titan+Cargo'">
                        <span class="absolute top-4 left-4 px-3 py-1 rounded-full bg-amber-600 text-white text-[10px] font-bold uppercase tracking-wider">Industrial</span>
                    </div>
                    <div class="p-6 space-y-4">
                        <h3 class="font-display text-xl font-bold">LEO Titan Cargo</h3>
                        <p class="text-slate-400 text-xs leading-relaxed">Heavy-duty goods and vehicle elevator engineered for warehouses, hospitals, and manufacturing complexes.</p>
                        
                        <div class="space-y-2 border-t border-slate-800 pt-4 text-xs font-mono text-slate-300">
                            <div class="flex justify-between">
                                <span class="text-slate-500">Speed:</span>
                                <span>1.5 m/s</span>
                            </div>
                            <div class="flex justify-between">
                                <span class="text-slate-500">Capacity:</span>
                                <span>Up to 5,000 kg</span>
                            </div>
                            <div class="flex justify-between">
                                <span class="text-slate-500">Protection:</span>
                                <span class="text-amber-400">Reinforced Steel Floor</span>
                            </div>
                        </div>

                        <a href="#customizer" class="block w-full text-center py-2.5 rounded-xl glass-panel hover:bg-slate-800 text-xs font-bold text-cyan-400 border border-cyan-500/30 transition-all">
                            Configure This Lift
                        </a>
                    </div>
                </div>

                <!-- Model 4 -->
