<!DOCTYPE html>
<html lang="en" class="dark scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="LEO Elevators - premier mobility and architectural lift solutions: home, passenger, panoramic, freight, hospital, car and accessible lifts.">
    <title>LEO Elevators | Premier Mobility & Architectural Lift Solutions</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Outfit:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: { sans: ['Inter', 'sans-serif'], display: ['Outfit', 'sans-serif'] },
                    animation: { 'float': 'float 6s ease-in-out infinite' },
                    keyframes: {
                        float: { '0%, 100%': { transform: 'translateY(0px)' }, '50%': { transform: 'translateY(-10px)' } }
                    }
                }
            }
        }
    </script>

    <style>
        body { background: #090D16; color: #f1f5f9; }
        .glass-panel {
            background: rgba(17, 24, 39, 0.7);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }
        section[id] { scroll-margin-top: 6rem; }

        .shaft-grid {
            background-size: 20px 20px;
            background-image:
                linear-gradient(to right, rgba(255,255,255,0.03) 1px, transparent 1px),
                linear-gradient(to bottom, rgba(255,255,255,0.03) 1px, transparent 1px);
        }

        /* Simulator doors */
        .door-left, .door-right { transition: transform 0.8s cubic-bezier(0.77, 0, 0.175, 1); }
        .doors-open .door-left { transform: translateX(-92%); }
        .doors-open .door-right { transform: translateX(92%); }

        ::-webkit-scrollbar { width: 8px; height: 8px; }
        ::-webkit-scrollbar-track { background: #090D16; }
        ::-webkit-scrollbar-thumb { background: #1E293B; border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: #06B6D4; }

        /* Cabin finishes */
        .style-gold   { background: linear-gradient(135deg, #2a2012 0%, #574119 50%, #1f170b 100%); border-color: #d4af37; }
        .style-steel  { background: linear-gradient(135deg, #1e293b 0%, #334155 50%, #0f172a 100%); border-color: #94a3b8; }
        .style-glass  { background: linear-gradient(135deg, #0284c7 0%, #0f172a 60%, #0369a1 100%); border-color: #38bdf8; }
        .style-walnut { background: linear-gradient(135deg, #3f2314 0%, #24140b 50%, #170b05 100%); border-color: #854d0e; }

        /* ---------- Scroll reveal animations ---------- */
        .reveal { opacity: 0; transform: translateY(40px); transition: opacity .8s ease, transform .8s cubic-bezier(.2,.7,.2,1); transition-delay: var(--d, 0s); }
        .reveal[data-anim="left"]  { transform: translateX(-60px); }
        .reveal[data-anim="right"] { transform: translateX(60px); }
        .reveal[data-anim="zoom"]  { transform: scale(.9); }
        .reveal.in-view { opacity: 1; transform: none; }

        /* ---------- Lift showcase carousel ---------- */
        .lift-scroller {
            display: flex; gap: 1.5rem; overflow-x: auto; scroll-snap-type: x mandatory;
            padding: 2rem calc(50% - 150px); scrollbar-width: none; -ms-overflow-style: none;
            perspective: 1200px; cursor: grab;
        }
        .lift-scroller::-webkit-scrollbar { display: none; }
        .lift-scroller.dragging { cursor: grabbing; scroll-snap-type: none; }
        .lift-card {
            flex: 0 0 300px; scroll-snap-align: center; position: relative; text-align: left;
            border-radius: 1.5rem; overflow: hidden; border: 1px solid #1F2937; background: #0f172a;
            transition: transform .25s ease-out, opacity .25s ease-out, border-color .3s, box-shadow .3s;
            will-change: transform, opacity; opacity: 0; transform: translateY(60px) scale(.9);
        }
        .lift-scroller.ready .lift-card { opacity: 1; }
        .lift-card:hover, .lift-card:focus-visible { border-color: #06B6D4; outline: none; box-shadow: 0 20px 50px -15px rgba(6,182,212,.45); }
        .lift-card.selected { border-color: #10B981; box-shadow: 0 0 0 2px #10B981, 0 20px 50px -15px rgba(16,185,129,.5); }
        .lift-card .photo { height: 210px; position: relative; overflow: hidden; background: linear-gradient(135deg,#1e293b,#0f172a); }
        .lift-card .photo img { position: absolute; inset: -12% -8%; width: 116%; height: 124%; object-fit: cover; transition: transform .6s; will-change: transform; }
        .lift-card:hover .photo img { transform: scale(1.08); }
        .lift-card .photo .fallback { position: absolute; inset: 0; display: none; align-items: center; justify-content: center; font-size: 4rem; opacity: .6; }
        .lift-card .check { position: absolute; top: .9rem; right: .9rem; width: 2rem; height: 2rem; border-radius: 9999px; background: #10B981; color: #fff; display: none; align-items: center; justify-content: center; font-size: .8rem; }
        .lift-card.selected .check { display: flex; }

        .scroll-progress { height: 3px; background: #1F2937; border-radius: 9999px; overflow: hidden; }
        .scroll-progress > div { height: 100%; width: 0; background: linear-gradient(90deg,#4F46E5,#06B6D4,#10B981); transition: width .15s; }

        @keyframes pop { 0% { transform: scale(.9); opacity: 0; } 100% { transform: scale(1); opacity: 1; } }
        .pop { animation: pop .35s ease-out; }
        #toast { transition: opacity .3s, transform .3s; }

        /* ---------- Light theme ---------- */
        html.light body { background: #f8fafc; color: #0f172a; }
        html.light .glass-panel { background: rgba(255,255,255,.85); border: 1px solid rgba(0,0,0,.08); }
        html.light .bg-slate-950, html.light .bg-slate-950\/60 { background-color: #eef2f7; }
        html.light .bg-slate-900, html.light .bg-slate-900\/90, html.light .bg-slate-900\/90 { background-color: #ffffff; }
        html.light .bg-slate-800 { background-color: #e2e8f0; }
        html.light .hover\:bg-slate-800:hover, html.light .hover\:bg-slate-700:hover { background-color: #cbd5e1; }
        html.light .text-slate-100, html.light .text-slate-200, html.light .text-slate-300 { color: #1e293b; }
        html.light .text-slate-400 { color: #475569; }
        html.light .text-white { color: #0f172a; }
        html.light .border-slate-800, html.light .border-slate-700 { border-color: #cbd5e1; }
        html.light .shaft-grid { background-color: #f1f5f9; }
        html.light .lift-card { background: #ffffff; border-color: #cbd5e1; }
        html.light .lift-card .meta-text { color: #0f172a; }
        html.light ::-webkit-scrollbar-track { background: #f1f5f9; }
        html.light .btn-gradient, html.light .btn-gradient * { color: #fff !important; }
        html.light .photo-caption, html.light .photo-caption * { color: #fff !important; }
        html.light #floorDisplay { color: #06B6D4; }
        html.light .cabin-preview-text { color: #fff; }

        @media (prefers-reduced-motion: reduce) {
            .reveal, .lift-card { transition: none !important; opacity: 1 !important; transform: none !important; }
            .door-left, .door-right { transition: none; }
            html { scroll-behavior: auto; }
        }
    </style>
</head>
<body class="font-sans antialiased selection:bg-cyan-500 selection:text-white transition-colors duration-300">

    <!-- Header -->
    <header class="sticky top-0 z-50 w-full" id="mainHeader">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex items-center justify-between h-20 glass-panel mt-3 rounded-2xl px-6 shadow-2xl">

                <a href="#hero" class="flex items-center gap-3 group" aria-label="LEO Elevators Home">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 280 50" width="200" height="38" class="transition-transform duration-300 group-hover:scale-[1.02]" role="img" aria-label="LEO Elevators logo">
                        <defs>
                            <linearGradient id="gradHeader" x1="0%" y1="100%" x2="100%" y2="0%">
                                <stop offset="0%" stop-color="#4F46E5" /><stop offset="50%" stop-color="#06B6D4" /><stop offset="100%" stop-color="#10B981" />
                            </linearGradient>
                            <filter id="logoGlow" x="-20%" y="-20%" width="140%" height="140%">
                                <feDropShadow dx="0" dy="4" stdDeviation="4" flood-color="#06B6D4" flood-opacity="0.35" />
                            </filter>
                        </defs>
                        <g filter="url(#logoGlow)">
                            <rect x="4" y="4" width="42" height="42" rx="12" fill="url(#gradHeader)" />
                            <rect x="13" y="15" width="2.5" height="20" rx="1.25" fill="#FFF" opacity="0.4" />
                            <rect x="34.5" y="15" width="2.5" height="20" rx="1.25" fill="#FFF" opacity="0.4" />
                            <path d="M25 13 L33 22 H28.5 V34 H21.5 V22 H17 Z" fill="#FFF" />
                        </g>
                        <g transform="translate(62, 0)">
                            <text x="0" y="32" font-family="Outfit, sans-serif" font-weight="900" font-size="22" fill="currentColor" letter-spacing="1.5">LEO</text>
                            <text x="54" y="32" font-family="Outfit, sans-serif" font-weight="400" font-size="14" fill="url(#gradHeader)" letter-spacing="3">ELEVATORS</text>
                        </g>
                    </svg>
                </a>

                <nav class="hidden lg:flex items-center space-x-8 text-sm font-medium" aria-label="Main">
                    <a href="#hero" class="nav-link text-slate-300 hover:text-cyan-400 transition-colors py-1">Home</a>
                    <a href="#lifts" class="nav-link text-slate-300 hover:text-cyan-400 transition-colors py-1">Lift Types</a>
                    <a href="#simulator" class="nav-link text-slate-300 hover:text-cyan-400 transition-colors py-1 flex items-center gap-1.5">
                        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span> Live Simulator
                    </a>
                    <a href="#customizer" class="nav-link text-slate-300 hover:text-cyan-400 transition-colors py-1">Customizer</a>
                    <a href="#tech" class="nav-link text-slate-300 hover:text-cyan-400 transition-colors py-1">Smart Tech</a>
                    <a href="#contact" class="nav-link text-slate-300 hover:text-cyan-400 transition-colors py-1">Contact</a>
                </nav>

                <div class="hidden sm:flex items-center space-x-4">
                    <button id="themeToggle" class="p-2.5 rounded-xl bg-slate-800/80 hover:bg-slate-700 text-cyan-400 border border-slate-700/50 transition-all focus:outline-none focus:ring-2 focus:ring-cyan-500" aria-label="Toggle dark or light mode">
                        <i class="fa-solid fa-moon text-lg dark:hidden"></i>
                        <i class="fa-solid fa-sun text-lg hidden dark:block"></i>
                    </button>
                    <a href="#customizer" class="btn-gradient inline-flex items-center justify-center px-5 py-2.5 rounded-xl text-xs font-bold uppercase tracking-wider text-white bg-gradient-to-r from-indigo-600 via-cyan-600 to-emerald-500 hover:opacity-95 shadow-lg shadow-cyan-500/20 transition-all hover:scale-[1.02]">
                        <i class="fa-solid fa-calculator mr-2"></i> Instant Quote
                    </a>
                </div>

                <button id="mobileMenuBtn" class="lg:hidden p-2 rounded-xl text-slate-300 hover:bg-slate-800 focus:outline-none" aria-label="Toggle mobile menu" aria-expanded="false" aria-controls="mobileMenu">
                    <i class="fa-solid fa-bars text-xl"></i>
                </button>
            </div>
        </div>

        <div id="mobileMenu" class="hidden lg:hidden max-w-7xl mx-auto px-4 mt-2">
            <div class="glass-panel rounded-2xl p-6 space-y-4 shadow-2xl flex flex-col">
                <a href="#hero" class="text-slate-200 hover:text-cyan-400 font-medium py-1">Home</a>
                <a href="#lifts" class="text-slate-200 hover:text-cyan-400 font-medium py-1">Lift Types</a>
                <a href="#simulator" class="text-slate-200 hover:text-cyan-400 font-medium py-1">Live Shaft Simulator</a>
                <a href="#customizer" class="text-slate-200 hover:text-cyan-400 font-medium py-1">Cabin Customizer</a>
                <a href="#tech" class="text-slate-200 hover:text-cyan-400 font-medium py-1">Smart Tech & Safety</a>
                <a href="#contact" class="text-slate-200 hover:text-cyan-400 font-medium py-1">Contact Us</a>
                <div class="pt-4 border-t border-slate-800 flex items-center justify-between">
                    <span class="text-xs text-slate-400">Switch Theme</span>
                    <button id="mobileThemeToggle" class="px-4 py-2 rounded-xl bg-slate-800 text-cyan-400 text-xs font-semibold">Toggle Light/Dark</button>
                </div>
                <a href="#customizer" class="btn-gradient w-full text-center py-3 rounded-xl font-bold text-xs uppercase tracking-wider text-white bg-gradient-to-r from-indigo-600 to-emerald-500">Get Custom Quote</a>
            </div>
        </div>
    </header>

    <main>
    <!-- Hero -->
    <section id="hero" class="relative pt-12 pb-20 md:pt-20 md:pb-28 overflow-hidden">
        <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-indigo-600/15 rounded-full blur-[140px] pointer-events-none"></div>
        <div class="absolute top-1/3 right-10 w-[400px] h-[400px] bg-cyan-500/15 rounded-full blur-[120px] pointer-events-none"></div>

        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">

                <div class="lg:col-span-7 space-y-8 text-center lg:text-left">
                    <div class="reveal inline-flex items-center gap-2 px-4 py-2 rounded-full glass-panel text-xs font-semibold text-cyan-400 border border-cyan-500/30">
                        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
                        Next-Gen Mobility Systems & AI Drive
                    </div>

                    <h1 class="reveal font-display text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight leading-[1.15]" style="--d:.1s">
                        Elevating Architectural <br class="hidden sm:block"/>
                        <span class="text-transparent bg-clip-text bg-gradient-to-r from-indigo-400 via-cyan-400 to-emerald-400">Luxury & Engineering Precision</span>
                    </h1>

                    <p class="reveal text-slate-400 text-base sm:text-lg max-w-2xl mx-auto lg:mx-0 leading-relaxed" style="--d:.2s">
                        Smart, sustainable, ultra-smooth elevator systems for villas, hospitals, high-rises and industrial towers. Powered by AI predictive maintenance and regenerative drives.
                    </p>

                    <div class="reveal flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 pt-2" style="--d:.3s">
                        <a href="#lifts" class="btn-gradient w-full sm:w-auto px-8 py-4 rounded-xl font-bold text-sm text-white bg-gradient-to-r from-indigo-600 via-cyan-600 to-emerald-500 hover:opacity-90 shadow-xl shadow-cyan-500/25 transition-all hover:-translate-y-0.5 text-center">
                            <i class="fa-solid fa-elevator mr-2"></i> Choose Your Lift
                        </a>
                        <a href="#simulator" class="w-full sm:w-auto px-8 py-4 rounded-xl font-bold text-sm text-slate-200 glass-panel hover:bg-slate-800/80 transition-all text-center">
                            <i class="fa-solid fa-play mr-2 text-cyan-400"></i> Try Lift Simulator
                        </a>
                    </div>

                    <div class="reveal pt-6 border-t border-slate-800/80 flex flex-wrap items-center justify-center lg:justify-start gap-6 text-xs text-slate-400" style="--d:.4s">
                        <span class="flex items-center gap-2"><i class="fa-solid fa-shield-halved text-emerald-400 text-base"></i> ISO 9001 Certified</span>
                        <span class="flex items-center gap-2"><i class="fa-solid fa-bolt text-amber-400 text-base"></i> Class A+++ Eco Drive</span>
                        <span class="flex items-center gap-2"><i class="fa-solid fa-building text-cyan-400 text-base"></i> EN81 Safety Compliance</span>
                    </div>
                </div>

                <div class="lg:col-span-5 relative reveal" data-anim="right" style="--d:.2s">
                    <div class="relative mx-auto max-w-md lg:max-w-none glass-panel p-6 rounded-3xl shadow-2xl overflow-hidden group">
                        <div class="relative h-[420px] rounded-2xl overflow-hidden bg-slate-900 flex items-center justify-center">
                            <img src="https://images.unsplash.com/photo-1541888946425-d0fbb186a5b3?auto=format&fit=crop&w=1000&q=80" alt="Luxury elevator architecture" loading="eager" class="w-full h-full object-cover opacity-80 group-hover:scale-105 transition-transform duration-700" onerror="this.style.display='none'">
                            <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/20 to-transparent"></div>

                            <div class="photo-caption absolute top-4 left-4 glass-panel px-4 py-2 rounded-xl text-xs font-semibold flex items-center gap-2">
                                <i class="fa-solid fa-gauge-high text-cyan-400"></i> Up to 6.0 m/s Speed
                            </div>

                            <div class="photo-caption absolute bottom-6 left-6 right-6 glass-panel p-4 rounded-xl space-y-2">
                                <div class="flex items-center justify-between text-xs">
                                    <span class="text-cyan-400 font-mono font-semibold">LEO SYNAPSE AI ENGINE</span>
                                    <span class="text-emerald-400 font-semibold"><i class="fa-solid fa-circle text-[8px] mr-1"></i> OPTIMAL</span>
                                </div>
                                <div class="w-full bg-slate-800 h-2 rounded-full overflow-hidden">
                                    <div class="bg-gradient-to-r from-indigo-500 via-cyan-400 to-emerald-400 h-full w-[88%] animate-pulse"></div>
                                </div>
                                <div class="flex justify-between text-[11px] text-slate-400 font-mono">
                                    <span>Vibration: 0.01 m/s²</span>
                                    <span>Energy Recycled: 34.2 kW</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="mt-16 grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6">
                <div class="reveal glass-panel p-6 rounded-2xl text-center hover:border-cyan-500/40 transition-colors" style="--d:0s">
                    <div class="font-display text-3xl sm:text-4xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-indigo-400 to-cyan-400" data-count="5000" data-suffix="+">5,000+</div>
                    <div class="text-xs sm:text-sm text-slate-400 font-medium mt-1">Global Installations</div>
                </div>
                <div class="reveal glass-panel p-6 rounded-2xl text-center hover:border-cyan-500/40 transition-colors" style="--d:.1s">
                    <div class="font-display text-3xl sm:text-4xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-emerald-400" data-count="99.98" data-decimals="2" data-suffix="%">99.98%</div>
                    <div class="text-xs sm:text-sm text-slate-400 font-medium mt-1">Operational Uptime</div>
                </div>
                <div class="reveal glass-panel p-6 rounded-2xl text-center hover:border-cyan-500/40 transition-colors" style="--d:.2s">
                    <div class="font-display text-3xl sm:text-4xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-indigo-400" data-count="15" data-suffix=" Mins">15 Mins</div>
                    <div class="text-xs sm:text-sm text-slate-400 font-medium mt-1">24/7 Rapid Response</div>
                </div>
                <div class="reveal glass-panel p-6 rounded-2xl text-center hover:border-cyan-500/40 transition-colors" style="--d:.3s">
                    <div class="font-display text-3xl sm:text-4xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-indigo-400 to-emerald-400" data-count="18" data-suffix="+">18+</div>
                    <div class="text-xs sm:text-sm text-slate-400 font-medium mt-1">Countries Served</div>
                </div>
            </div>
        </div>
    </section>

    <!-- LIFT TYPES SHOWCASE -->
    <section id="lifts" class="py-20 bg-slate-950/60 border-y border-slate-800/80 overflow-hidden">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="reveal text-center max-w-3xl mx-auto mb-6 space-y-4">
                <span class="text-indigo-400 text-xs font-bold uppercase tracking-widest px-3.5 py-1.5 rounded-full glass-panel border border-indigo-500/30">Product Portfolio</span>
                <h2 class="font-display text-3xl sm:text-4xl font-extrabold">Choose Your Lift Type</h2>
                <p class="text-slate-400 text-sm sm:text-base">Scroll through every lift we build. Click a lift to select it and jump straight into the customizer.</p>
            </div>
        </div>

        <div class="relative">
            <div id="liftScroller" class="lift-scroller" role="listbox" aria-label="Lift types"></div>

            <button id="liftPrev" class="hidden sm:flex absolute left-4 lg:left-10 top-1/2 -translate-y-1/2 z-20 w-12 h-12 rounded-full glass-panel items-center justify-center text-cyan-400 hover:scale-110 transition-transform" aria-label="Previous lift"><i class="fa-solid fa-chevron-left"></i></button>
            <button id="liftNext" class="hidden sm:flex absolute right-4 lg:right-10 top-1/2 -translate-y-1/2 z-20 w-12 h-12 rounded-full glass-panel items-center justify-center text-cyan-400 hover:scale-110 transition-transform" aria-label="Next lift"><i class="fa-solid fa-chevron-right"></i></button>
        </div>

        <div class="max-w-md mx-auto px-6 mt-2 space-y-4">
            <div class="scroll-progress"><div id="liftProgress"></div></div>
            <p class="text-center text-xs text-slate-500"><i class="fa-solid fa-hand-pointer text-cyan-400 mr-1"></i> Swipe, drag or use arrow keys</p>
        </div>
    </section>

    <!-- Simulator -->
    <section id="simulator" class="py-20 relative">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="reveal text-center max-w-3xl mx-auto mb-16 space-y-4">
                <span class="text-cyan-400 text-xs font-bold uppercase tracking-widest px-3.5 py-1.5 rounded-full glass-panel border border-cyan-500/30">Interactive Tech Experience</span>
                <h2 class="font-display text-3xl sm:text-4xl font-extrabold">Live Shaft & Floor Call Simulator</h2>
                <p class="text-slate-400 text-sm sm:text-base">Test our ultra-smooth leveling and floor dispatch control panel in real time.</p>
            </div>

            <div class="reveal glass-panel rounded-3xl p-6 sm:p-8 shadow-2xl max-w-5xl mx-auto" data-anim="zoom">
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">

                    <div class="lg:col-span-7 bg-slate-900 rounded-2xl p-6 border border-slate-800 shaft-grid relative min-h-[460px] flex flex-col justify-between overflow-hidden">
                        <div class="flex items-center justify-between border-b border-slate-800 pb-3 z-10 px-2">
                            <div class="flex items-center gap-2">
                                <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
                                <span class="text-xs font-mono text-slate-300">LEO GEARLESS TRACTION MOTOR #01</span>
                            </div>
                            <span class="text-[11px] font-mono text-cyan-400" id="liftSpeedReadout">0.0 m/s</span>
                        </div>

                        <div class="relative flex-1 my-4" id="shaftTrack">
                            <div class="absolute inset-0 flex flex-col justify-between pointer-events-none py-2 text-xs font-mono text-slate-500">
                                <div class="border-b border-dashed border-slate-700 flex justify-between pb-1"><span>FL 5 - Sky Deck</span><span class="text-[10px]">20.0m</span></div>
                                <div class="border-b border-dashed border-slate-700 flex justify-between pb-1"><span>FL 4 - Penthouse Executive</span><span class="text-[10px]">16.0m</span></div>
                                <div class="border-b border-dashed border-slate-700 flex justify-between pb-1"><span>FL 3 - Corporate Suites</span><span class="text-[10px]">12.0m</span></div>
                                <div class="border-b border-dashed border-slate-700 flex justify-between pb-1"><span>FL 2 - Tech Hub</span><span class="text-[10px]">8.0m</span></div>
                                <div class="border-b border-dashed border-slate-700 flex justify-between pb-1"><span>FL 1 - Innovation Lounge</span><span class="text-[10px]">4.0m</span></div>
                                <div class="border-b border-dashed border-slate-700 flex justify-between pb-1"><span>FL 0 - Grand Lobby (G)</span><span class="text-[10px]">0.0m</span></div>
                            </div>

                            <div id="elevatorCab" class="absolute left-1/2 -translate-x-1/2 w-48 h-16 sm:h-20 bg-slate-800 rounded-xl border-2 border-cyan-500 shadow-lg shadow-cyan-500/20 flex items-center overflow-hidden" style="bottom: 0; transition-property: bottom; transition-timing-function: ease-in-out; transition-duration: 0s;">
                                <div class="absolute inset-0 bg-cyan-500/10 pointer-events-none"></div>
                                <div class="relative w-full h-full rounded-lg bg-slate-950 flex overflow-hidden border border-slate-700" id="doorContainer">
                                    <div class="absolute inset-0 flex items-center justify-center text-slate-400 text-xs font-mono">
                                        <i class="fa-solid fa-user-tie text-cyan-400 mr-1"></i> PASSENGERS
                                    </div>
                                    <div class="door-left relative z-10 w-1/2 h-full bg-gradient-to-r from-slate-800 to-slate-700 border-r border-cyan-500/50 flex items-center justify-end pr-1">
                                        <div class="w-1 h-8 bg-slate-600 rounded-full"></div>
                                    </div>
                                    <div class="door-right relative z-10 w-1/2 h-full bg-gradient-to-l from-slate-800 to-slate-700 border-l border-cyan-500/50 flex items-center justify-start pl-1">
                                        <div class="w-1 h-8 bg-slate-600 rounded-full"></div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="flex items-center justify-between border-t border-slate-800 pt-3 text-[11px] font-mono text-slate-400 z-10 px-2">
                            <span>HYDRAULIC BUFFER: READY</span>
                            <span class="text-emerald-400"><i class="fa-solid fa-lock text-[10px] mr-1"></i> SAFETY GEAR ENGAGED</span>
                        </div>
                    </div>

                    <div class="lg:col-span-5 bg-slate-900/90 rounded-2xl p-6 border border-slate-800 flex flex-col items-center justify-center space-y-6">
                        <div class="w-full bg-black p-4 rounded-xl border-2 border-slate-800 text-center space-y-1 shadow-inner">
                            <div class="flex items-center justify-between text-xs font-mono text-slate-500 border-b border-slate-800 pb-2">
                                <span>DIGITAL COP DISPLAY</span>
                                <button type="button" id="soundStatus" class="text-cyan-400" aria-label="Toggle arrival chime"><i class="fa-solid fa-volume-high"></i> CHIME ON</button>
                            </div>
                            <div class="flex items-center justify-center gap-4 pt-2">
                                <span id="directionArrow" class="text-slate-600 font-bold text-3xl" aria-hidden="true">▲</span>
                                <span id="floorDisplay" class="font-mono text-5xl font-black text-cyan-400 tracking-wider" aria-live="polite">G</span>
                            </div>
                            <div id="statusMessage" class="text-xs font-mono text-emerald-400 pt-1" aria-live="polite">STATIONARY AT GRAND LOBBY</div>
                        </div>

                        <div class="w-full space-y-3">
                            <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider block text-center">Select Destination Floor</span>
                            <div class="grid grid-cols-3 gap-3" id="copButtons"></div>
                        </div>

                        <div class="w-full grid grid-cols-3 gap-3 pt-2">
                            <button id="btnOpen" class="py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 font-semibold text-xs border border-slate-700 flex items-center justify-center gap-1.5"><i class="fa-solid fa-arrows-left-right text-cyan-400"></i> Open</button>
                            <button id="btnClose" class="py-2.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-300 font-semibold text-xs border border-slate-700 flex items-center justify-center gap-1.5"><i class="fa-solid fa-compress text-cyan-400"></i> Close</button>
                            <button id="btnStop" class="py-2.5 rounded-xl bg-rose-950/80 hover:bg-rose-900 text-rose-300 font-bold text-xs border border-rose-800 flex items-center justify-center gap-1.5"><i class="fa-solid fa-triangle-exclamation text-rose-400"></i> STOP</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Customizer -->
    <section id="customizer" class="py-24 relative bg-slate-950/60 border-y border-slate-800/80">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="reveal text-center max-w-3xl mx-auto mb-16 space-y-4">
                <span class="text-emerald-400 text-xs font-bold uppercase tracking-widest px-3.5 py-1.5 rounded-full glass-panel border border-emerald-500/30">Real-time Configurator</span>
                <h2 class="font-display text-3xl sm:text-4xl font-extrabold">Cabin Customizer & Instant Estimator</h2>
                <p class="text-slate-400 text-sm sm:text-base">Tailor materials, doors and floor count to generate an architectural cost estimate.</p>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
                <div class="reveal lg:col-span-6 space-y-6 glass-panel p-6 sm:p-8 rounded-3xl" data-anim="left">

                    <div>
                        <span class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-3">1. Lift Type</span>
                        <div class="grid grid-cols-2 sm:grid-cols-3 gap-3" id="typeButtons"></div>
                    </div>

                    <div class="space-y-2 pt-2">
                        <div class="flex justify-between items-center text-xs font-bold uppercase tracking-wider text-slate-300">
                            <label for="floorSlider">2. Number of Floors / Stops</label>
                            <span id="floorSliderVal" class="text-cyan-400 font-mono text-base font-extrabold">4 Stops</span>
                        </div>
                        <input type="range" id="floorSlider" min="2" max="30" value="4" class="w-full h-2 bg-slate-800 rounded-lg appearance-none cursor-pointer accent-cyan-400">
                        <div class="flex justify-between text-[10px] text-slate-500 font-mono" id="sliderScale">
                            <span>2</span><span id="sliderMid">16</span><span id="sliderMax">30</span>
                        </div>
                    </div>

                    <div>
                        <span class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-3">3. Cabin Interior Finish</span>
                        <div class="grid grid-cols-2 gap-3" id="finishButtons"></div>
                    </div>

                    <div>
                        <label for="doorSelect" class="block text-xs font-bold uppercase tracking-wider text-slate-300 mb-2">4. Door Mechanism</label>
                        <select id="doorSelect" class="w-full bg-slate-900 border border-slate-800 rounded-xl px-4 py-3 text-sm text-slate-200 focus:outline-none focus:border-cyan-500">
                            <option value="0">Automatic Center Opening (Standard)</option>
                            <option value="1500">Telescopic Side Sliding (+$1,500)</option>
                            <option value="3000">Frameless Glass Automatic (+$3,000)</option>
                        </select>
                    </div>
                </div>

                <div class="lg:col-span-6 space-y-6">
                    <div class="reveal glass-panel p-6 rounded-3xl text-center relative overflow-hidden" data-anim="right">
                        <div class="flex items-center justify-between text-xs font-mono text-slate-400 mb-4">
                            <span><i class="fa-solid fa-cube text-cyan-400 mr-1"></i> LIVE INTERIOR PREVIEW</span>
                            <span id="finishBadge" class="text-amber-400 font-semibold">GOLD MIRROR STYLE</span>
                        </div>

                        <div id="cabinPreviewBox" class="w-full h-64 rounded-2xl border-4 transition-all duration-500 relative flex flex-col justify-between p-4 overflow-hidden style-gold">
                            <div class="w-full h-3 rounded-full bg-white shadow-lg shadow-white/80"></div>
                            <div class="flex-1 my-3 border border-white/20 rounded-xl bg-white/5 backdrop-blur-sm relative flex items-center justify-center">
                                <div class="w-3/4 h-1 bg-slate-300/60 rounded-full shadow-md"></div>
                                <span class="cabin-preview-text absolute top-2 text-[10px] font-mono text-white/60 tracking-widest" id="cabinLabel">LEO ARCHITECTURAL</span>
                            </div>
                            <div class="w-full h-5 bg-gradient-to-r from-slate-900 via-slate-800 to-slate-900 rounded-lg border-t border-white/20 flex items-center justify-center">
                                <div class="w-12 h-1 bg-cyan-400/80 rounded-full"></div>
                            </div>
                        </div>
                        <p class="text-[11px] text-slate-500 mt-3">Visual representation only. Exact textures & handrails subject to architectural drawings.</p>
                    </div>

                    <div class="reveal glass-panel p-6 sm:p-8 rounded-3xl border border-cyan-500/30 shadow-xl space-y-6" data-anim="right" style="--d:.1s">
                        <div class="flex items-center justify-between gap-3 border-b border-slate-800 pb-4">
                            <div>
                                <h3 class="text-xs font-bold uppercase tracking-wider text-slate-400">Estimated Project Investment</h3>
                                <div id="totalPrice" class="font-display text-4xl sm:text-5xl font-black text-transparent bg-clip-text bg-gradient-to-r from-indigo-400 via-cyan-400 to-emerald-400 mt-1">$30,500</div>
                            </div>
                            <span class="px-3 py-1 rounded-full bg-emerald-500/10 text-emerald-400 border border-emerald-500/30 text-xs font-semibold whitespace-nowrap"><i class="fa-solid fa-check text-[10px] mr-1"></i> Budget Estimate</span>
                        </div>

                        <div class="space-y-2 text-xs font-mono text-slate-300">
                            <div class="flex justify-between"><span class="text-slate-400" id="itemTypeLabel">Base Equipment:</span><span id="itemBase">$22,000</span></div>
                            <div class="flex justify-between"><span class="text-slate-400">Extra Floor Stops:</span><span id="itemFloors">$2,000</span></div>
                            <div class="flex justify-between"><span class="text-slate-400">Interior Styling:</span><span id="itemFinish">$4,500</span></div>
                            <div class="flex justify-between"><span class="text-slate-400">Door System:</span><span id="itemDoors">$0</span></div>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2">
                            <button id="btnSpec" class="py-3 px-4 rounded-xl glass-panel hover:bg-slate-800 text-xs font-bold text-slate-200 transition-all flex items-center justify-center gap-2"><i class="fa-solid fa-file-arrow-down text-cyan-400"></i> Save Spec Sheet</button>
                            <a href="#contact" id="btnLock" class="btn-gradient py-3 px-4 rounded-xl bg-gradient-to-r from-indigo-600 to-emerald-500 hover:opacity-90 text-xs font-bold text-white transition-all text-center flex items-center justify-center gap-2"><i class="fa-solid fa-paper-plane"></i> Lock In Quote</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Tech -->
    <section id="tech" class="py-24 relative">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="reveal text-center max-w-3xl mx-auto mb-16 space-y-4">
                <span class="text-emerald-400 text-xs font-bold uppercase tracking-widest px-3.5 py-1.5 rounded-full glass-panel border border-emerald-500/30">Engineering Excellence</span>
                <h2 class="font-display text-3xl sm:text-4xl font-extrabold">Smart Mobility & Safety Innovations</h2>
                <p class="text-slate-400 text-sm sm:text-base">Every LEO elevator is built around four core pillars.</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
                <div class="reveal glass-panel p-8 rounded-3xl hover:border-emerald-500/50 transition-all group" style="--d:0s">
                    <div class="w-14 h-14 rounded-2xl bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-emerald-400 text-2xl mb-6 group-hover:scale-110 transition-transform"><i class="fa-solid fa-leaf"></i></div>
                    <h3 class="font-display text-xl font-bold mb-3">Regenerative Drive</h3>
                    <p class="text-slate-400 text-xs leading-relaxed">Feeds up to 30% of braking energy back into the building's grid, lowering operating power costs.</p>
                </div>
                <div class="reveal glass-panel p-8 rounded-3xl hover:border-cyan-500/50 transition-all group" style="--d:.1s">
                    <div class="w-14 h-14 rounded-2xl bg-cyan-500/10 border border-cyan-500/30 flex items-center justify-center text-cyan-400 text-2xl mb-6 group-hover:scale-110 transition-transform"><i class="fa-solid fa-microchip"></i></div>
                    <h3 class="font-display text-xl font-bold mb-3">AI Predictive Health</h3>
                    <p class="text-slate-400 text-xs leading-relaxed">Continuous IoT monitoring detects mechanical wear before it causes downtime and dispatches technicians automatically.</p>
                </div>
                <div class="reveal glass-panel p-8 rounded-3xl hover:border-indigo-500/50 transition-all group" style="--d:.2s">
                    <div class="w-14 h-14 rounded-2xl bg-indigo-500/10 border border-indigo-500/30 flex items-center justify-center text-indigo-400 text-2xl mb-6 group-hover:scale-110 transition-transform"><i class="fa-solid fa-mobile-screen-button"></i></div>
                    <h3 class="font-display text-xl font-bold mb-3">Touchless Call Controls</h3>
                    <p class="text-slate-400 text-xs leading-relaxed">Mobile app integration, QR scanning and gesture controls for hygienic cabin operation.</p>
                </div>
                <div class="reveal glass-panel p-8 rounded-3xl hover:border-rose-500/50 transition-all group" style="--d:.3s">
                    <div class="w-14 h-14 rounded-2xl bg-rose-500/10 border border-rose-500/30 flex items-center justify-center text-rose-400 text-2xl mb-6 group-hover:scale-110 transition-transform"><i class="fa-solid fa-life-ring"></i></div>
                    <h3 class="font-display text-xl font-bold mb-3">ARD Rescue System</h3>
                    <p class="text-slate-400 text-xs leading-relaxed">Automatic Rescue Device lowers the cabin to the nearest floor and opens the doors during power outages.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Contact -->
    <section id="contact" class="py-24 bg-slate-950/60 border-t border-slate-800">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">

                <div class="reveal lg:col-span-5 space-y-8" data-anim="left">
                    <div>
                        <span class="text-cyan-400 text-xs font-bold uppercase tracking-widest px-3.5 py-1.5 rounded-full glass-panel border border-cyan-500/30">Get In Touch</span>
                        <h2 class="font-display text-3xl sm:text-4xl font-extrabold mt-4">Request Your Architectural Consultation</h2>
                        <p class="text-slate-400 text-sm mt-3 leading-relaxed">Our engineering team will assist with technical specifications, shaft measurements and custom pricing.</p>
                    </div>

                    <div class="space-y-6 text-sm text-slate-300">
                        <div class="flex items-start gap-4">
                            <div class="w-10 h-10 rounded-xl bg-cyan-500/10 border border-cyan-500/30 flex items-center justify-center text-cyan-400 shrink-0"><i class="fa-solid fa-location-dot"></i></div>
                            <div><div class="font-bold">Global Headquarters</div><div class="text-xs text-slate-400 mt-0.5">LEO Mobility Tower, Innovation Park, London & Dubai</div></div>
                        </div>
                        <div class="flex items-start gap-4">
                            <div class="w-10 h-10 rounded-xl bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-center text-emerald-400 shrink-0"><i class="fa-solid fa-phone"></i></div>
                            <div><div class="font-bold">24/7 Hotline & Support</div><div class="text-xs text-slate-400 mt-0.5">+1 (800) 536-ELEV / <a href="mailto:support@leoelevators.com" class="hover:text-cyan-400">support@leoelevators.com</a></div></div>
                        </div>
                        <div class="flex items-start gap-4">
                            <div class="w-10 h-10 rounded-xl bg-indigo-500/10 border border-indigo-500/30 flex items-center justify-center text-indigo-400 shrink-0"><i class="fa-solid fa-clock"></i></div>
                            <div><div class="font-bold">Response Time Guarantee</div><div class="text-xs text-slate-400 mt-0.5">Formal quotes within 2 hours for commercial inquiries.</div></div>
                        </div>
                    </div>
                </div>

                <div class="reveal lg:col-span-7 glass-panel p-8 sm:p-10 rounded-3xl shadow-2xl" data-anim="right">
                    <form id="quoteForm" class="space-y-5">
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                            <div>
                                <label for="fName" class="block text-xs font-semibold text-slate-300 mb-2">Full Name *</label>
                                <input id="fName" type="text" required autocomplete="name" placeholder="e.g. Alexander Wright" class="w-full bg-slate-900 border border-slate-800 rounded-xl px-4 py-3 text-sm text-slate-200 focus:outline-none focus:border-cyan-500">
                            </div>
                            <div>
                                <label for="fEmail" class="block text-xs font-semibold text-slate-300 mb-2">Work Email *</label>
                                <input id="fEmail" type="email" required autocomplete="email" placeholder="alexander@architects.com" class="w-full bg-slate-900 border border-slate-800 rounded-xl px-4 py-3 text-sm text-slate-200 focus:outline-none focus:border-cyan-500">
                            </div>
                        </div>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
                            <div>
                                <label for="fPhone" class="block text-xs font-semibold text-slate-300 mb-2">Phone Number</label>
                                <input id="fPhone" type="tel" autocomplete="tel" placeholder="+1 (555) 000-0000" class="w-full bg-slate-900 border border-slate-800 rounded-xl px-4 py-3 text-sm text-slate-200 focus:outline-none focus:border-cyan-500">
                            </div>
                            <div>
                                <label for="formBuildingType" class="block text-xs font-semibold text-slate-300 mb-2">Lift Type</label>
                                <select id="formBuildingType" class="w-full bg-slate-900 border border-slate-800 rounded-xl px-4 py-3 text-sm text-slate-200 focus:outline-none focus:border-cyan-500"></select>
                            </div>
                        </div>
                        <div>
                            <label for="formMessage" class="block text-xs font-semibold text-slate-300 mb-2">Project Notes / Shaft Dimensions</label>
                            <textarea id="formMessage" rows="4" placeholder="Mention floor stops, speed requirement or architectural preferences..." class="w-full bg-slate-900 border border-slate-800 rounded-xl px-4 py-3 text-sm text-slate-200 focus:outline-none focus:border-cyan-500 resize-none"></textarea>
                        </div>
                        <button type="submit" class="btn-gradient w-full py-4 rounded-xl font-bold text-xs uppercase tracking-wider text-white bg-gradient-to-r from-indigo-600 via-cyan-600 to-emerald-500 hover:opacity-95 shadow-xl transition-all">Submit Consultation Request</button>
                    </form>
                </div>
            </div>
        </div>
    </section>
    </main>

