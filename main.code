<!DOCTYPE html>
<html lang="en" class="dark scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Leo Elevators | Next-Gen Luxury Elevators & Interactive Budget Estimator</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    colors: {
                        gold: {
                            100: '#FFF8E7',
                            300: '#F5E0A3',
                            400: '#E6C363',
                            500: '#D4AF37',
                            600: '#AA8820',
                            700: '#806311',
                        },
                        darkbg: {
                            900: '#0B0D12',
                            800: '#131722',
                            700: '#1C2232',
                            600: '#283044',
                        }
                    },
                    fontFamily: {
                        sans: ['Plus Jakarta Sans', 'sans-serif'],
                        serif: ['Playfair Display', 'serif'],
                    },
                    animation: {
                        'pulse-glow': 'pulseGlow 3s infinite alternate',
                        'float': 'float 4s ease-in-out infinite',
                    },
                    keyframes: {
                        pulseGlow: {
                            '0%': { boxShadow: '0 0 15px rgba(212, 175, 55, 0.15)' },
                            '100%': { boxShadow: '0 0 35px rgba(212, 175, 55, 0.35)' },
                        },
                        float: {
                            '0%, 100%': { transform: 'translateY(0px)' },
                            '50%': { transform: 'translateY(-8px)' },
                        }
                    }
                }
            }
        }
    </script>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;1,400&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- Lucide Icons CDN -->
    <script src="https://unpkg.com/lucide@latest"></script>
    
    <style>
        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #0B0D12;
        }
        ::-webkit-scrollbar-thumb {
            background: #283044;
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #D4AF37;
        }

        .gold-gradient-text {
            background: linear-gradient(135deg, #FFF3D1 0%, #D4AF37 50%, #997A15 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .gold-gradient-bg {
            background: linear-gradient(135deg, #E6C363 0%, #D4AF37 50%, #B88E18 100%);
        }

        .gold-border-glow {
            border: 1px solid rgba(212, 175, 55, 0.3);
            box-shadow: 0 0 20px rgba(212, 175, 55, 0.08);
        }

        .glass-card {
            background: rgba(19, 23, 34, 0.75);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.07);
        }

        /* Lift Cab Textures & Dynamic Visual Styles */
        .cabin-texture-hairline {
            background: linear-gradient(180deg, #2a2d34 0%, #474c56 50%, #20232a 100%);
            border: 2px solid #606877;
        }
        
        .cabin-texture-gold {
            background: linear-gradient(180deg, #594511 0%, #B88E18 50%, #42320A 100%);
            border: 2px solid #E6C363;
            box-shadow: inset 0 0 30px rgba(255, 220, 120, 0.3);
        }

        .cabin-texture-glass {
            background: rgba(40, 120, 180, 0.15);
            border: 2px solid rgba(120, 200, 255, 0.4);
            backdrop-filter: blur(4px);
            box-shadow: inset 0 0 20px rgba(100, 200, 255, 0.2);
        }

        .cabin-texture-wood {
            background: linear-gradient(180deg, #4A2810 0%, #2D1808 100%);
            border: 2px solid #8B5A2B;
            box-shadow: inset 0 0 25px rgba(212, 175, 55, 0.2);
        }

        .cabin-texture-rosegold {
            background: linear-gradient(180deg, #60383A 0%, #A36B6E 50%, #422425 100%);
            border: 2px solid #E0A0A3;
            box-shadow: inset 0 0 25px rgba(240, 180, 185, 0.25);
        }

        /* Floor animation transition */
        .lift-cabin-motion {
            transition: transform 1.2s cubic-bezier(0.45, 0.05, 0.55, 0.95);
        }
    </style>
</head>
<body class="bg-darkbg-900 text-slate-100 font-sans antialiased selection:bg-gold-500 selection:text-darkbg-900 overflow-x-hidden">

    <!-- Sticky Navigation Bar -->
    <header class="fixed top-0 left-0 w-full z-50 glass-card transition-all duration-300 border-b border-white/10">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between">
            <!-- Brand Logo -->
            <a href="#" class="flex items-center gap-3 group">
                <div class="w-10 h-10 rounded-xl gold-gradient-bg flex items-center justify-center text-darkbg-900 font-black text-xl shadow-lg shadow-gold-500/20 group-hover:scale-105 transition-transform">
                    L
                </div>
                <div>
                    <span class="text-xl font-bold tracking-wider text-white font-serif block leading-none">LEO <span class="gold-gradient-text">ELEVATORS</span></span>
                    <span class="text-[10px] tracking-widest text-slate-400 uppercase font-medium">Vertical Engineering Excellence</span>
                </div>
            </a>

            <!-- Navigation Links -->
            <nav class="hidden md:flex items-center gap-8 text-sm font-medium text-slate-300">
                <a href="#calculator" class="hover:text-gold-400 transition-colors flex items-center gap-1.5">
                    <i data-lucide="calculator" class="w-4 h-4 text-gold-500"></i>
                    Cost Estimator
                </a>
                <a href="#models" class="hover:text-gold-400 transition-colors">Elevator Series</a>
                <a href="#tech" class="hover:text-gold-400 transition-colors">Smart Tech</a>
                <a href="#projects" class="hover:text-gold-400 transition-colors">Projects</a>
                <a href="#faq" class="hover:text-gold-400 transition-colors">FAQ</a>
            </nav>

            <!-- Currency Switcher & CTA -->
            <div class="flex items-center gap-4">
                <!-- Currency Toggle -->
                <div class="bg-darkbg-800 p-1 rounded-lg border border-slate-700/60 flex items-center text-xs font-semibold">
                    <button id="curr-inr" onclick="setCurrency('INR')" class="px-2.5 py-1 rounded-md transition-all bg-gold-500 text-darkbg-900 shadow">₹ INR</button>
                    <button id="curr-usd" onclick="setCurrency('USD')" class="px-2.5 py-1 rounded-md transition-all text-slate-400 hover:text-white">$ USD</button>
                </div>

                <!-- Primary CTA -->
                <a href="#calculator" class="hidden sm:inline-flex items-center gap-2 gold-gradient-bg text-darkbg-900 font-bold px-5 py-2.5 rounded-xl hover:brightness-110 transition-all shadow-md shadow-gold-500/20 text-sm">
                    <i data-lucide="sliders" class="w-4 h-4"></i>
                    <span>Customize & Price</span>
                </a>

                <!-- Mobile Menu Button -->
                <button onclick="toggleMobileMenu()" class="md:hidden text-slate-300 hover:text-white p-2">
                    <i data-lucide="menu" class="w-6 h-6"></i>
                </button>
            </div>
        </div>

        <!-- Mobile Drawer Menu -->
        <div id="mobile-menu" class="hidden md:hidden bg-darkbg-800 border-b border-slate-700 px-6 py-4 space-y-3">
            <a href="#calculator" onclick="toggleMobileMenu()" class="block text-slate-200 hover:text-gold-400 py-1 font-medium">Cost Estimator</a>
            <a href="#models" onclick="toggleMobileMenu()" class="block text-slate-200 hover:text-gold-400 py-1 font-medium">Elevator Series</a>
            <a href="#tech" onclick="toggleMobileMenu()" class="block text-slate-200 hover:text-gold-400 py-1 font-medium">Smart Tech</a>
            <a href="#projects" onclick="toggleMobileMenu()" class="block text-slate-200 hover:text-gold-400 py-1 font-medium">Projects</a>
            <a href="#faq" onclick="toggleMobileMenu()" class="block text-slate-200 hover:text-gold-400 py-1 font-medium">FAQ</a>
        </div>
    </header>

    <!-- Hero Section -->
    <section class="relative pt-32 pb-20 md:pt-40 md:pb-28 overflow-hidden bg-gradient-to-b from-darkbg-900 via-darkbg-800 to-darkbg-900">
        <!-- Background Lighting Orbs -->
        <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-gold-500/10 blur-[140px] rounded-full pointer-events-none"></div>
        <div class="absolute top-1/3 -right-20 w-[400px] h-[400px] bg-amber-600/10 blur-[120px] rounded-full pointer-events-none"></div>

        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
                <!-- Left Text Content -->
                <div class="lg:col-span-7 text-center lg:text-left space-y-6">
                    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full glass-card border border-gold-500/30 text-gold-400 text-xs font-semibold uppercase tracking-wider animate-pulse-glow">
                        <i data-lucide="sparkles" class="w-3.5 h-3.5"></i>
                        <span>Next-Gen German Hydraulic & Gearless Technology</span>
                    </div>

                    <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold font-serif text-white tracking-tight leading-tight">
                        Redefining <span class="gold-gradient-text">Vertical Mobility</span> With Luxury & Precision.
                    </h1>

                    <p class="text-slate-300 text-base sm:text-lg max-w-2xl mx-auto lg:mx-0 leading-relaxed font-light">
                        Engineering whisper-quiet, ultra-safe, and architecturally stunning elevators for modern villas, luxury penthouses, high-rise towers, and hospitals.
                    </p>

                    <!-- CTAs -->
                    <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 pt-2">
                        <a href="#calculator" class="w-full sm:w-auto inline-flex items-center justify-center gap-3 gold-gradient-bg text-darkbg-900 font-bold px-8 py-4 rounded-xl hover:scale-105 transition-all shadow-lg shadow-gold-500/25 text-base">
                            <i data-lucide="calculator" class="w-5 h-5"></i>
                            <span>Build & Calculate Cost Now</span>
                        </a>
                        <a href="#models" class="w-full sm:w-auto inline-flex items-center justify-center gap-2 glass-card text-white hover:text-gold-400 font-semibold px-7 py-4 rounded-xl border border-slate-700 hover:border-gold-500/50 transition-all text-base">
                            <i data-lucide="eye" class="w-5 h-5 text-gold-400"></i>
                            <span>View Elevator Models</span>
                        </a>
                    </div>

                    <!-- Dynamic Statistics Counter -->
                    <div class="pt-8 border-t border-slate-800/80 grid grid-cols-2 sm:grid-cols-4 gap-6 text-left">
                        <div class="p-3 rounded-lg bg-darkbg-800/50 border border-slate-800">
                            <div class="text-2xl sm:text-3xl font-extrabold text-gold-400 font-serif">1,850+</div>
                            <div class="text-xs text-slate-400 mt-1 font-medium">Lifts Installed</div>
                        </div>
                        <div class="p-3 rounded-lg bg-darkbg-800/50 border border-slate-800">
                            <div class="text-2xl sm:text-3xl font-extrabold text-white font-serif">99.98%</div>
                            <div class="text-xs text-slate-400 mt-1 font-medium">Safety Rating</div>
                        </div>
                        <div class="p-3 rounded-lg bg-darkbg-800/50 border border-slate-800">
                            <div class="text-2xl sm:text-3xl font-extrabold text-gold-400 font-serif">&lt;15 Min</div>
                            <div class="text-xs text-slate-400 mt-1 font-medium">Emergency Response</div>
                        </div>
                        <div class="p-3 rounded-lg bg-darkbg-800/50 border border-slate-800">
                            <div class="text-2xl sm:text-3xl font-extrabold text-white font-serif">15 Yrs</div>
                            <div class="text-xs text-slate-400 mt-1 font-medium">Warranty Options</div>
                        </div>
                    </div>
                </div>

                <!-- Right Hero Visual Banner -->
                <div class="lg:col-span-5 relative flex justify-center">
                    <div class="relative w-full max-w-md aspect-[3/4] rounded-3xl glass-card overflow-hidden p-6 gold-border-glow animate-float">
                        <!-- Glass Elevator Shaft Graphic -->
                        <div class="w-full h-full rounded-2xl bg-gradient-to-b from-darkbg-900/90 via-darkbg-700/60 to-darkbg-900/90 border border-gold-500/20 relative flex flex-col justify-between p-4 overflow-hidden">
                            <!-- Cables -->
                            <div class="absolute inset-y-0 left-1/4 w-[1px] bg-gradient-to-b from-gold-500/40 via-slate-500/20 to-gold-500/40"></div>
                            <div class="absolute inset-y-0 right-1/4 w-[1px] bg-gradient-to-b from-gold-500/40 via-slate-500/20 to-gold-500/40"></div>
                            
                            <div class="flex justify-between items-center z-10">
                                <span class="text-[10px] font-mono uppercase bg-gold-500/20 text-gold-300 px-2.5 py-1 rounded-full border border-gold-500/30">LEO-SERIES 2026</span>
                                <div class="flex items-center gap-1">
                                    <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
                                    <span class="text-xs text-emerald-400 font-semibold">ONLINE READY</span>
                                </div>
                            </div>

                            <!-- Animated Visual Lift Box -->
                            <div class="relative w-full h-48 rounded-xl cabin-texture-gold p-4 flex flex-col justify-between shadow-2xl my-auto transition-all">
                                <div class="flex justify-between items-center text-xs text-amber-200">
                                    <span class="font-mono">FLOOR: 12</span>
                                    <div class="flex items-center gap-1 text-[10px] bg-darkbg-900/80 px-2 py-0.5 rounded text-gold-400">
                                        <i data-lucide="shield-check" class="w-3 h-3"></i> ARD ACTIVE
                                    </div>
                                </div>

                                <!-- Cabin Interior Lighting Visual -->
                                <div class="flex justify-center items-center gap-3">
                                    <div class="w-12 h-20 rounded border border-white/30 bg-white/10 flex items-center justify-center">
                                        <i data-lucide="user" class="w-6 h-6 text-gold-300/80"></i>
                                    </div>
                                    <div class="w-12 h-20 rounded border border-white/30 bg-white/10 flex items-center justify-center">
                                        <i data-lucide="user" class="w-6 h-6 text-gold-300/80"></i>
                                    </div>
                                </div>

                                <div class="h-1 w-full bg-gradient-to-r from-transparent via-gold-300 to-transparent"></div>
                            </div>

                            <div class="text-center z-10">
                                <p class="text-xs text-slate-300 font-medium">Smart PMSM Direct Drive Motor</p>
                                <p class="text-[10px] text-slate-500">Ultra Low Power • No Gearbox Noise</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Main Interactive Calculator Section -->
    <section id="calculator" class="py-20 bg-darkbg-900 relative">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <!-- Section Header -->
            <div class="text-center max-w-3xl mx-auto mb-16">
                <span class="text-gold-400 text-xs font-bold uppercase tracking-widest bg-gold-500/10 px-3.5 py-1.5 rounded-full border border-gold-500/20">Instant Budget Engine</span>
                <h2 class="text-3xl sm:text-4xl font-bold font-serif text-white mt-4">Elevator Customizer & Price Calculator</h2>
                <p class="text-slate-400 mt-3 text-sm sm:text-base">Configure your project specifications below. Watch the cabin visual preview and real-time estimate update instantly.</p>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
                
                <!-- LEFT COLUMN: Multi-Step Configuration Panel (7 Columns) -->
                <div class="lg:col-span-7 space-y-8">
                    
                    <!-- STEP 1: Select Elevator Type -->
                    <div class="glass-card p-6 rounded-2xl border border-slate-800">
                        <div class="flex items-center gap-3 mb-5">
                            <div class="w-8 h-8 rounded-lg gold-gradient-bg flex items-center justify-center text-darkbg-900 font-bold text-sm">1</div>
                            <div>
                                <h3 class="text-lg font-bold text-white">Select Elevator Type</h3>
                                <p class="text-xs text-slate-400">Choose the ideal application for your building structure</p>
                            </div>
                        </div>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3" id="lift-type-container">
                            <!-- Rendered dynamically or styled via JS -->
                            <button onclick="selectLiftType('passenger')" id="type-passenger" class="lift-type-card p-4 rounded-xl border border-gold-500 bg-gold-500/10 text-left transition-all hover:border-gold-400 group relative">
                                <div class="flex items-center justify-between mb-2">
                                    <i data-lucide="building" class="w-6 h-6 text-gold-400"></i>
                                    <span class="text-[10px] uppercase font-bold text-gold-400 bg-gold-500/20 px-2 py-0.5 rounded">Most Popular</span>
                                </div>
                                <h4 class="font-bold text-white text-sm">Passenger Elevator</h4>
                                <p class="text-xs text-slate-400 mt-1">Residential apartments & office towers</p>
                            </button>

                            <button onclick="selectLiftType('villa')" id="type-villa" class="lift-type-card p-4 rounded-xl border border-slate-800 bg-darkbg-800 text-left transition-all hover:border-gold-400 group">
                                <div class="flex items-center justify-between mb-2">
                                    <i data-lucide="home" class="w-6 h-6 text-slate-400 group-hover:text-gold-400"></i>
                                </div>
                                <h4 class="font-bold text-white text-sm">Luxury Villa / Home Lift</h4>
                                <p class="text-xs text-slate-400 mt-1">Compact pitless design for private homes</p>
                            </button>

                            <button onclick="selectLiftType('panoramic')" id="type-panoramic" class="lift-type-card p-4 rounded-xl border border-slate-800 bg-darkbg-800 text-left transition-all hover:border-gold-400 group">
                                <div class="flex items-center justify-between mb-2">
                                    <i data-lucide="sparkles" class="w-6 h-6 text-slate-400 group-hover:text-gold-400"></i>
                                </div>
                                <h4 class="font-bold text-white text-sm">Panoramic Glass Lift</h4>
                                <p class="text-xs text-slate-400 mt-1">360° Scenic glass view for luxury estates</p>
                            </button>

                            <button onclick="selectLiftType('freight')" id="type-freight" class="lift-type-card p-4 rounded-xl border border-slate-800 bg-darkbg-800 text-left transition-all hover:border-gold-400 group">
                                <div class="flex items-center justify-between mb-2">
                                    <i data-lucide="truck" class="w-6 h-6 text-slate-400 group-hover:text-gold-400"></i>
                                </div>
                                <h4 class="font-bold text-white text-sm">Commercial & Goods</h4>
                                <p class="text-xs text-slate-400 mt-1">Heavy payload industrial freight</p>
                            </button>

                            <button onclick="selectLiftType('hospital')" id="type-hospital" class="lift-type-card sm:col-span-2 p-4 rounded-xl border border-slate-800 bg-darkbg-800 text-left transition-all hover:border-gold-400 group">
                                <div class="flex items-center justify-between mb-2">
                                    <i data-lucide="heart-pulse" class="w-6 h-6 text-slate-400 group-hover:text-gold-400"></i>
                                </div>
                                <h4 class="font-bold text-white text-sm">Hospital Bed Elevator</h4>
                                <p class="text-xs text-slate-400 mt-1">Deep cabin for stretchers, smooth stretch shock absorption</p>
                            </button>
                        </div>
                    </div>

                    <!-- STEP 2: Floors / Stops Slider -->
                    <div class="glass-card p-6 rounded-2xl border border-slate-800">
                        <div class="flex items-center justify-between mb-5">
                            <div class="flex items-center gap-3">
                                <div class="w-8 h-8 rounded-lg gold-gradient-bg flex items-center justify-center text-darkbg-900 font-bold text-sm">2</div>
                                <div>
                                    <h3 class="text-lg font-bold text-white">Number of Floors / Stops</h3>
                                    <p class="text-xs text-slate-400">Select total levels (Ground + Floors)</p>
                                </div>
                            </div>
                            <div class="text-right">
                                <span id="floor-display-val" class="text-2xl font-extrabold text-gold-400 font-serif">G + 2 Floors</span>
                                <span id="floor-count-sub" class="text-xs text-slate-400 block">(3 Stops Total)</span>
                            </div>
                        </div>

                        <!-- Range Slider -->
                        <div class="space-y-4">
                            <input type="range" id="floor-slider" min="1" max="25" value="2" oninput="updateFloors(this.value)" class="w-full h-2 bg-slate-700 rounded-lg appearance-none cursor-pointer accent-gold-500">
                            
                            <!-- Quick Floor Buttons -->
                            <div class="flex flex-wrap gap-2 pt-2">
                                <button onclick="setFloorVal(1)" class="px-3 py-1.5 rounded-lg text-xs font-semibold bg-darkbg-800 border border-slate-700 hover:border-gold-500 text-slate-300">G+1 (2 Stops)</button>
                                <button onclick="setFloorVal(2)" class="px-3 py-1.5 rounded-lg text-xs font-semibold bg-gold-500/20 border border-gold-500 text-gold-400">G+2 (3 Stops)</button>
                                <button onclick="setFloorVal(4)" class="px-3 py-1.5 rounded-lg text-xs font-semibold bg-darkbg-800 border border-slate-700 hover:border-gold-500 text-slate-300">G+4 (5 Stops)</button>
                                <button onclick="setFloorVal(7)" class="px-3 py-1.5 rounded-lg text-xs font-semibold bg-darkbg-800 border border-slate-700 hover:border-gold-500 text-slate-300">G+7 (8 Stops)</button>
                                <button onclick="setFloorVal(12)" class="px-3 py-1.5 rounded-lg text-xs font-semibold bg-darkbg-800 border border-slate-700 hover:border-gold-500 text-slate-300">G+12 High Rise</button>
                            </div>
                        </div>
                    </div>

                    <!-- STEP 3: Capacity Selection -->
                    <div class="glass-card p-6 rounded-2xl border border-slate-800">
                        <div class="flex items-center gap-3 mb-5">
                            <div class="w-8 h-8 rounded-lg gold-gradient-bg flex items-center justify-center text-darkbg-900 font-bold text-sm">3</div>
                            <div>
                                <h3 class="text-lg font-bold text-white">Passenger Capacity & Weight Limit</h3>
                                <p class="text-xs text-slate-400">Select duty load capacity for your cabin</p>
                            </div>
                        </div>

                        <div class="grid grid-cols-2 sm:grid-cols-5 gap-2.5" id="capacity-container">
                            <button onclick="selectCapacity(4, 300, 1.0, this)" class="cap-btn p-3 rounded-xl border border-slate-800 bg-darkbg-800 text-center hover:border-gold-500 transition-all">
                                <span class="block text-sm font-bold text-white">4 Pax</span>
                                <span class="text-[10px] text-slate-400">300 kg</span>
                            </button>
                            <button onclick="selectCapacity(6, 408, 1.12, this)" class="cap-btn p-3 rounded-xl border border-gold-500 bg-gold-500/10 text-center transition-all">
                                <span class="block text-sm font-bold text-gold-400">6 Pax</span>
                                <span class="text-[10px] text-slate-400">408 kg</span>
                            </button>
                            <button onclick="selectCapacity(8, 544, 1.25, this)" class="cap-btn p-3 rounded-xl border border-slate-800 bg-darkbg-800 text-center hover:border-gold-500 transition-all">
                                <span class="block text-sm font-bold text-white">8 Pax</span>
                                <span class="text-[10px] text-slate-400">544 kg</span>
                            </button>
                            <button onclick="selectCapacity(10, 680, 1.40, this)" class="cap-btn p-3 rounded-xl border border-slate-800 bg-darkbg-800 text-center hover:border-gold-500 transition-all">
